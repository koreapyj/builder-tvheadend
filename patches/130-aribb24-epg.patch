+#if ENABLE_ARIBB24
+/*
+ * ARIB STD-B10 (ISDB / Japanese DTV) EIT specifics.
+ *
+ * Every ARIB code path below is active only for services whose resolved
+ * charset is "ARIB-STD-B24" (set on the network / mux / service), so DVB
+ * networks are entirely unaffected.
+ */
+static inline int _eit_is_arib ( const eit_event_t *ev )
+{
+  return ev->default_charset && !strcmp(ev->default_charset, "ARIB-STD-B24");
+}
+
+/* ARIB content_nibble_level_1 -> nearest DVB ETSI content byte (major level;
+ * sub-genre is intentionally coarse). 0x00 = leave ungenred. */
+static const uint8_t _eit_arib_genre_l1[16] = {
+  0x20, /* 0x0 News / Reporting        -> News / Current affairs    */
+  0x40, /* 0x1 Sports                  -> Sports                    */
+  0x80, /* 0x2 Information / wide-show  -> Social / Political / Eco. */
+  0x10, /* 0x3 Drama                   -> Movie / Drama             */
+  0x60, /* 0x4 Music                   -> Music / Ballet / Dance    */
+  0x30, /* 0x5 Variety                 -> Show / Game show          */
+  0x10, /* 0x6 Movie                   -> Movie / Drama             */
+  0x55, /* 0x7 Anime / Special effects -> Children's: Cartoons      */
+  0x23, /* 0x8 Documentary / Culture   -> News: Documentary         */
+  0x70, /* 0x9 Theatre / Performance   -> Arts / Culture            */
+  0xa0, /* 0xA Hobby / Education       -> Leisure hobbies           */
+  0x80, /* 0xB Welfare                 -> Social / Political / Eco. */
+  0x00, /* 0xC reserved                                             */
+  0x00, /* 0xD reserved                                             */
+  0x00, /* 0xE extension (user nibbles)                             */
+  0x00, /* 0xF other                                                */
+};
+#endif
