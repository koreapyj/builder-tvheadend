+#if ENABLE_ARIBB24
+/*
+ * ARIB Series Descriptor - 0xD5
+ *
+ * Carries episode numbering for serial ISDB programmes. Payload layout:
+ *   [0..1] series_id
+ *   [2]    repeat_label(4) program_pattern(3) expire_date_valid_flag(1)
+ *   [3..4] expire_date
+ *   [5]    episode_number high 8 bits
+ *   [6]    episode_number low 4 bits | last_episode_number high 4 bits
+ *   [7]    last_episode_number low 8 bits
+ *   [8..]  series_name_char
+ */
+static int _eit_desc_series
+  ( epggrab_module_t *mod, const uint8_t *ptr, int len,
+    eit_event_t *ev, eit_data_t *ed )
+{
+  uint16_t series_id, episode, last;
+
+  if (!_eit_is_arib(ev)) return 0;
+  if (len < 8) return 0;
+
+  series_id = (ptr[0] << 8) | ptr[1];
+  episode   = (ptr[5] << 4) | (ptr[6] >> 4);
+  last      = ((ptr[6] & 0x0f) << 8) | ptr[7];
+
+  tvhtrace(mod->subsys, "%s:  ARIB series id %u episode %u/%u",
+           mod->id, series_id, episode, last);
+
+  if (episode) ev->en.e_num = episode;
+  if (last)    ev->en.e_cnt = last;
+
+  /* Group episodes of the same series, unless a CRID already supplied one. */
+  if (series_id && !ev->suri[0])
+    snprintf(ev->suri, sizeof(ev->suri), "crid://arib-series.%u.%u",
+             ed->onid, series_id);
+
+  return 0;
+}
+
+/*
+ * ARIB Event Group Descriptor - 0xD6 (ARIB STD-B10)
+ *
+ *   group_type : 4   event_count : 4
+ *   for (i=0; i<event_count; i++) { service_id:16  event_id:16 }
+ *   if (group_type == 4 || group_type == 5) {
+ *     for (each remaining tuple) {
+ *       original_network_id:16  transport_stream_id:16
+ *       service_id:16            event_id:16
+ *     }
+ *   }
+ *
+ * The same-TS entries reference events on the carrying mux (no onid/tsid
+ * carried, so the caller's coordinates apply). group_type 4/5 (other-network)
+ * carries full (onid,tsid,sid,eid) tuples in the trailing block.
+ *
+ * Records the references on the event for later resolution. The slave-service
+ * EIT normally has a blank or placeholder short_event_descriptor; the resolver
+ * (called near _eit_process_event_one's finish) copies the master event's
+ * title onto the slave.
+ */
+static int _eit_desc_event_group
+  ( epggrab_module_t *mod, const uint8_t *ptr, int len, eit_event_t *ev )
+{
+  uint8_t group_type, event_count, i;
+  int pos;
+
+  if (!_eit_is_arib(ev)) return 0;
+  if (len < 1) return 0;
+
+  group_type  = ptr[0] >> 4;
+  event_count = ptr[0] & 0x0f;
+  ev->group_type = group_type;
+
+  tvhtrace(mod->subsys,
+           "%s:  ARIB event group type %u count %u",
+           mod->id, group_type, event_count);
+
+  /* Same-TS (sid,eid) pairs, always present */
+  pos = 1;
+  for (i = 0; i < event_count; i++) {
+    if (pos + 4 > len) break;
+    if (ev->group_ref_count < EIT_GROUP_REF_MAX) {
+      eit_event_ref_t *r = &ev->group_refs[ev->group_ref_count++];
+      r->onid = 0;
+      r->tsid = 0;
+      r->sid  = (ptr[pos] << 8) | ptr[pos+1];
+      r->eid  = (ptr[pos+2] << 8) | ptr[pos+3];
+    }
+    pos += 4;
+  }
+
+  /* Other-network full tuples (onid,tsid,sid,eid) */
+  if (group_type == 4 || group_type == 5) {
+    while (pos + 8 <= len) {
+      if (ev->group_ref_count < EIT_GROUP_REF_MAX) {
+        eit_event_ref_t *r = &ev->group_refs[ev->group_ref_count++];
+        r->onid = (ptr[pos]   << 8) | ptr[pos+1];
+        r->tsid = (ptr[pos+2] << 8) | ptr[pos+3];
+        r->sid  = (ptr[pos+4] << 8) | ptr[pos+5];
+        r->eid  = (ptr[pos+6] << 8) | ptr[pos+7];
+      }
+      pos += 8;
+    }
+  }
+
+  return 0;
+}
+
+/*
+ * ARIB event_group_descriptor resolver
+ *
+ * Looks up the master event referenced by the (sid,eid) — or full
+ * (onid,tsid,sid,eid) for other-network types — and copies its title
+ * (and other empty fields) onto the slave event. Single-pass: if the
+ * master is not yet in the EPG DB, the next cyclic EIT pass will retry.
+ * Must run with global_lock held.
+ */
+static void _eit_resolve_event_group
+  ( epggrab_module_t *mod, eit_data_t *ed, mpegts_service_t *carry_svc,
+    eit_event_t *ev )
+{
+  mpegts_network_t *mn;
+  mpegts_mux_t *mm;
+  mpegts_service_t *msvc;
+  idnode_list_mapping_t *ilm;
+  channel_t *ch;
+  epg_broadcast_t *master;
+  uint16_t onid, tsid;
+  const char *t;
+  int i;
+
+  if (ev->group_ref_count == 0) return;
+  if (!carry_svc || !carry_svc->s_dvb_mux) return;
+  mn = carry_svc->s_dvb_mux->mm_network;
+  if (!mn) return;
+
+  for (i = 0; i < ev->group_ref_count; i++) {
+    eit_event_ref_t *r = &ev->group_refs[i];
+    onid = r->onid ? r->onid : ed->onid;
+    tsid = r->tsid ? r->tsid : ed->tsid;
+
+    mm = mpegts_network_find_mux(mn, onid, tsid, 1);
+    if (!mm) continue;
+    msvc = mpegts_mux_find_service(mm, r->sid);
+    if (!msvc) continue;
+
+    LIST_FOREACH(ilm, &msvc->s_channels, ilm_in1_link) {
+      ch = (channel_t *)ilm->ilm_in2;
+      if (!ch->ch_enabled) continue;
+      master = epg_broadcast_find_by_eid(ch, r->eid);
+      if (!master) continue;
+
+      /* Title: overwrite — the broadcaster's slave placeholder is what we
+       * want to replace. */
+      if (master->title) {
+        if (ev->title) lang_str_destroy(ev->title);
+        ev->title = lang_str_copy(master->title);
+      }
+      /* Secondary fields: only fill when slave provided nothing. */
+      if (!ev->subtitle && master->subtitle)
+        ev->subtitle = lang_str_copy(master->subtitle);
+      if (!ev->summary && master->summary)
+        ev->summary = lang_str_copy(master->summary);
+      if (!ev->desc && master->description)
+        ev->desc = lang_str_copy(master->description);
+
+      t = ev->title ? lang_str_get(ev->title, NULL) : NULL;
+      tvhtrace(mod->subsys,
+               "%s:  event_group resolved type=%u onid=%u tsid=%u sid=%u eid=%u -> '%s'",
+               mod->id, ev->group_type, onid, tsid, r->sid, r->eid,
+               t ? t : "");
+      return;
+    }
+  }
+}
+#endif
