+/* True if s holds at least one non-blank character. ARIB EIT pads text with
+ * ASCII spaces and the ideographic space U+3000 (UTF-8 E3 80 80); a short
+ * event whose name is only padding must not overwrite a real title/summary
+ * obtained from another EIT pass. */
+static int _eit_str_has_content ( const char *s )
+{
+  const uint8_t *p = (const uint8_t *)s;
+  while (*p) {
+    if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')
+      p++;
+    else if (p[0] == 0xE3 && p[1] == 0x80 && p[2] == 0x80)
+      p += 3;                       /* U+3000 ideographic space */
+    else
+      return 1;
+  }
+  return 0;
+}
