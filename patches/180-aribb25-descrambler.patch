+ *  This program is distributed in the hope that it will be useful,
+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ *  GNU General Public License for more details.
+ */
+
+#include "tvheadend.h"
+#include "settings.h"
+#include "caclient.h"
+#include "service.h"
+#include "input.h"
+#include "sbuf.h"
+#include "descrambler/descrambler.h"
+#include "descrambler/caid.h"
+
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <poll.h>
+#include <pthread.h>
+
+#include <aribb25/arib_std_b25.h>
+#include <aribb25/b_cas_card.h>
+#include <aribb25/b_cas_cobalt.h>
+
+#define ARIBB25_BCAS_CAID         0x0005
+
+#define ARIBB25_BACKEND_COBALT    0
+#define ARIBB25_BACKEND_PCSC      1
+
+typedef struct aribb25             aribb25_t;
+typedef struct aribb25_mux         aribb25_mux_t;
+typedef struct aribb25_descrambler aribb25_descrambler_t;
+
+struct aribb25_descrambler {
+  th_descrambler_t;
+  aribb25_mux_t   *ad_mux_state;
+  mpegts_mux_t    *ad_mux;        /* needed for descrambler_close_pid on destroy */
+  mpegts_apids_t   ad_ecm_pids;   /* ECM PIDs we opened with descrambler_open_pid */
+};
+
+/*
+ * Per-mux descrambler state. Created lazily when a service on that mux first
+ * reports a B-CAS CAID; torn down when the last such service goes away.
+ */
+struct aribb25_mux {
+  LIST_ENTRY(aribb25_mux) am_link;
+  aribb25_t              *am_owner;
+  mpegts_mux_t           *am_mux;
+  ARIB_STD_B25           *am_b25;
+  B_CAS_CARD             *am_bcas;
+  int                     am_refcount;     /* live ECM PIDs */
+  int                     am_init_failed;  /* avoid log-spamming on retry */
+  tvh_mutex_t             am_lock;         /* serialises filter/teardown */
+  sbuf_t                  am_pending;      /* libaribb25 output backlog */
+};
+
+struct aribb25 {
+  caclient_t;
+
+  /* configurable via the web UI */
+  int    ab_card_backend;
+  int    ab_process_emm;
+  int    ab_multi2_round;
+  char  *ab_cobalt_card_image_path;
+  int    ab_cobalt_log_mode;
+
+  LIST_HEAD(, aribb25_mux) ab_muxes;
+  tvh_mutex_t              ab_lock;
+};
+
+/* ************************************************************************
+ * Per-mux helpers
+ * ***********************************************************************/
+
+static aribb25_mux_t *
+aribb25_mux_find ( aribb25_t *ab, mpegts_mux_t *mux )
+{
+  aribb25_mux_t *am;
+  LIST_FOREACH(am, &ab->ab_muxes, am_link)
+    if (am->am_mux == mux) return am;
+  return NULL;
+}
+
+static int
+aribb25_filter ( mpegts_mux_t *mm, uint8_t *buf, int len )
+{
+  aribb25_mux_t *am = mm->mm_filter_aux;
+  ARIB_STD_B25_BUFFER ibuf, obuf;
+  int outlen;
+
+  if (am == NULL || am->am_b25 == NULL)
+    return len;
+
+  tvh_mutex_lock(&am->am_lock);
+  if (am->am_b25 == NULL) {
+    tvh_mutex_unlock(&am->am_lock);
+    return len;
+  }
+
+  /* Feed input to libaribb25. */
+  ibuf.data = buf;
+  ibuf.size = (uint32_t)len;
+  if (am->am_b25->put(am->am_b25, &ibuf) < 0) {
+    tvh_mutex_unlock(&am->am_lock);
+    /* on a hard error pass the (still-scrambled) bytes through rather than
+     * silently dropping them; downstream will see scrambled flags set */
+    return len;
+  }
+
+  /* Pull whatever descrambled output is ready and append to the backlog.
+   * libaribb25 holds packets until an ECM is decoded, then emits them in
+   * bursts that may exceed the input batch — so we accumulate across
+   * calls and drain at most `len` bytes back into the caller's buffer. */
+  obuf.data = NULL;
+  obuf.size = 0;
+  if (am->am_b25->get(am->am_b25, &obuf) == 0 && obuf.size > 0)
+    sbuf_append(&am->am_pending, obuf.data, (int)obuf.size);
+
+  outlen = am->am_pending.sb_ptr;
+  if (outlen > len) outlen = len;
+  outlen -= outlen % 188;   /* keep packet boundaries clean */
+  if (outlen > 0) {
+    memcpy(buf, am->am_pending.sb_data, outlen);
+    sbuf_cut(&am->am_pending, outlen);
+  }
+
+  tvh_mutex_unlock(&am->am_lock);
+  return outlen;
+}
+
+/* ************************************************************************
+ * CobaltCas log redirection
+ *
+ * CobaltCas's only log sink is a regular file at sys.LOG_FILE_NAME. To
+ * route those messages into tvheadend's log we point it at a FIFO and
+ * spawn a reader thread that drains the FIFO and emits each line via
+ * tvhlog (LS_ARIBB25, prefix "cobaltcas:"). Setup happens once per
+ * process, the first time aribb25 with the cobalt backend is brought up.
+ * ***********************************************************************/
+
+static pthread_once_t aribb25_cobalt_log_once = PTHREAD_ONCE_INIT;
+static char           aribb25_cobalt_log_path[256];
+static int            aribb25_cobalt_log_fd = -1;
+static pthread_t      aribb25_cobalt_log_thread;
+static int            aribb25_cobalt_log_thread_started = 0;
+
+static void *
+aribb25_cobalt_log_reader ( void *aux )
+{
+  char buf[4096];
+  char line[1024];
+  size_t line_len = 0;
+
+  while (tvheadend_is_running()) {
+    struct pollfd pfd = { .fd = aribb25_cobalt_log_fd, .events = POLLIN };
+    int pr = poll(&pfd, 1, 500);   /* 500 ms — coarse enough for shutdown */
+    if (pr < 0) {
+      if (errno == EINTR) continue;
+      break;
+    }
+    if (pr == 0) continue;
+    if (!(pfd.revents & POLLIN)) continue;
+
+    ssize_t n = read(aribb25_cobalt_log_fd, buf, sizeof(buf));
+    if (n <= 0) {
+      if (n < 0 && errno == EINTR) continue;
+      if (n < 0 && errno == EAGAIN) continue;
+      break;
+    }
+    for (ssize_t i = 0; i < n; i++) {
+      char c = buf[i];
+      if (c == '\n' || line_len >= sizeof(line) - 1) {
+        line[line_len] = '\0';
+        if (line_len > 0)
+          tvhinfo(LS_ARIBB25, "cobaltcas: %s", line);
+        line_len = 0;
+        if (c != '\n' && c != '\r') line[line_len++] = c;
+      } else if (c != '\r') {
+        line[line_len++] = c;
+      }
+    }
+  }
+  return NULL;
+}
+
+static void
+aribb25_cobalt_log_init_once ( void )
+{
+  /* PID-tagged path so multiple tvheadend processes don't collide. */
+  snprintf(aribb25_cobalt_log_path, sizeof(aribb25_cobalt_log_path),
+           "/tmp/tvh-cobaltcas-%d.fifo", (int)getpid());
+
+  /* Best-effort cleanup of a stale FIFO from a previous run with the same
+   * PID; ignore errors. */
+  unlink(aribb25_cobalt_log_path);
+
+  if (mkfifo(aribb25_cobalt_log_path, 0600) != 0) {
+    tvherror(LS_ARIBB25, "cobaltcas: mkfifo(%s) failed: %s",
+             aribb25_cobalt_log_path, strerror(errno));
+    aribb25_cobalt_log_path[0] = '\0';
+    return;
+  }
+
+  /* O_RDWR keeps the FIFO open from both sides so CobaltCas's repeated
+   * ofstream open/close cycles never see "no reader" and never block. */
+  aribb25_cobalt_log_fd = open(aribb25_cobalt_log_path,
+                               O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  if (aribb25_cobalt_log_fd < 0) {
+    tvherror(LS_ARIBB25, "cobaltcas: open(%s) failed: %s",
+             aribb25_cobalt_log_path, strerror(errno));
+    unlink(aribb25_cobalt_log_path);
+    aribb25_cobalt_log_path[0] = '\0';
+    return;
+  }
+
+  if (tvh_thread_create(&aribb25_cobalt_log_thread, NULL,
+                        aribb25_cobalt_log_reader, NULL,
+                        "aribb25-coblog") != 0) {
+    tvherror(LS_ARIBB25, "cobaltcas: log reader thread create failed");
+    close(aribb25_cobalt_log_fd);
+    aribb25_cobalt_log_fd = -1;
+    unlink(aribb25_cobalt_log_path);
+    aribb25_cobalt_log_path[0] = '\0';
+    return;
+  }
+  aribb25_cobalt_log_thread_started = 1;
+  tvhdebug(LS_ARIBB25, "cobaltcas: log routed to tvheadend via %s",
+           aribb25_cobalt_log_path);
+}
+
+/*
+ * Returns the FIFO path that CobaltCas should write its log to. Empty
+ * string on init failure (caller should fall back to the user-configured
+ * path so the operator at least has something).
+ */
+static const char *
+aribb25_cobalt_log_fifo ( void )
+{
+  pthread_once(&aribb25_cobalt_log_once, aribb25_cobalt_log_init_once);
+  return aribb25_cobalt_log_path[0] ? aribb25_cobalt_log_path : NULL;
+}
+
+static aribb25_mux_t *
+aribb25_mux_create ( aribb25_t *ab, mpegts_mux_t *mux )
+{
+  aribb25_mux_t *am;
+  int r;
+
+  am = calloc(1, sizeof(*am));
+  am->am_owner = ab;
+  am->am_mux   = mux;
+  tvh_mutex_init(&am->am_lock, NULL);
+  sbuf_init(&am->am_pending);
+
+  am->am_b25 = create_arib_std_b25();
+  if (am->am_b25 == NULL) {
+    tvherror(LS_ARIBB25, "create_arib_std_b25 failed");
+    goto fail;
+  }
+  am->am_b25->set_multi2_round(am->am_b25,
+                               ab->ab_multi2_round > 0 ? ab->ab_multi2_round : 4);
+  am->am_b25->set_strip(am->am_b25, 0);
+  am->am_b25->set_emm_proc(am->am_b25, ab->ab_process_emm ? 1 : 0);
+  am->am_b25->set_unit_size(am->am_b25, 188);
+
+  if (ab->ab_card_backend == ARIBB25_BACKEND_COBALT) {
+    am->am_bcas = create_b_cas_cobalt();
+    /* create_b_cas_cobalt() resets sys.{CARD_IMAGE_FILE_NAME,LOG_FILE_NAME,
+     * logMode} to its built-in defaults at the end of the call, so the
+     * configurable setters MUST run after it, not before, to take effect.
+     * Route CobaltCas's file-based logger through a FIFO so its messages
+     * land in tvheadend's log. */
+    b_cas_cobalt_set_card_image_path(ab->ab_cobalt_card_image_path);
+    b_cas_cobalt_set_log_file_path(aribb25_cobalt_log_fifo());
+    b_cas_cobalt_set_log_mode(ab->ab_cobalt_log_mode);
+  } else {
+    am->am_bcas = create_b_cas_card();
+  }
+  if (am->am_bcas == NULL) {
+    tvherror(LS_ARIBB25, "B-CAS card create failed (backend=%s)",
+             ab->ab_card_backend == ARIBB25_BACKEND_COBALT ? "cobalt" : "pcsc");
+    goto fail;
+  }
+  if ((r = am->am_bcas->init(am->am_bcas)) < 0) {
+    tvherror(LS_ARIBB25, "B-CAS card init failed (backend=%s, rc=%d)",
+             ab->ab_card_backend == ARIBB25_BACKEND_COBALT ? "cobalt" : "pcsc", r);
+    goto fail;
+  }
+  if ((r = am->am_b25->set_b_cas_card(am->am_b25, am->am_bcas)) < 0) {
+    tvherror(LS_ARIBB25, "set_b_cas_card failed (rc=%d)", r);
+    goto fail;
+  }
+
+  mux->mm_filter_aux     = am;
+  mux->mm_filter_packets = aribb25_filter;
+
+  LIST_INSERT_HEAD(&ab->ab_muxes, am, am_link);
+  tvhinfo(LS_ARIBB25, "mux %p: descrambler attached (backend=%s, emm=%d)",
+          mux,
+          ab->ab_card_backend == ARIBB25_BACKEND_COBALT ? "cobalt" : "pcsc",
+          ab->ab_process_emm ? 1 : 0);
+  caclient_set_status((caclient_t *)ab, CACLIENT_STATUS_CONNECTED);
+  return am;
+
+fail:
+  if (am->am_b25)
+    am->am_b25->release(am->am_b25);
+  if (am->am_bcas)
+    am->am_bcas->release(am->am_bcas);
+  sbuf_free(&am->am_pending);
+  tvh_mutex_destroy(&am->am_lock);
+  free(am);
+  caclient_set_status((caclient_t *)ab, CACLIENT_STATUS_DISCONNECTED);
+  return NULL;
+}
+
+static void
+aribb25_mux_destroy ( aribb25_mux_t *am )
+{
+  mpegts_mux_t *mux = am->am_mux;
+
+  tvh_mutex_lock(&am->am_lock);
+  mux->mm_filter_packets = NULL;
+  mux->mm_filter_aux     = NULL;
+  if (am->am_b25)  { am->am_b25->release(am->am_b25);   am->am_b25  = NULL; }
+  if (am->am_bcas) { am->am_bcas->release(am->am_bcas); am->am_bcas = NULL; }
+  sbuf_free(&am->am_pending);
+  tvh_mutex_unlock(&am->am_lock);
+
+  LIST_REMOVE(am, am_link);
+  tvh_mutex_destroy(&am->am_lock);
+  free(am);
+
+  tvhinfo(LS_ARIBB25, "mux %p: descrambler detached", mux);
+}
+
+static void
+aribb25_destroy_all_muxes ( aribb25_t *ab )
+{
+  aribb25_mux_t *am;
+  while ((am = LIST_FIRST(&ab->ab_muxes)) != NULL)
+    aribb25_mux_destroy(am);
+}
+
+/* ************************************************************************
+ * Per-service descrambler.
+ *
+ * The actual MULTI2 work is done at the mux level by `aribb25_filter`, but
+ * tvheadend still needs a `th_descrambler_t` registered on the service for
+ * the descrambler subsystem to consider the service descramblable
+ * (otherwise the subscription is rejected with "no descrambler"). The
+ * service-level descramble callback is `descrambler_pass` — by the time
+ * per-PID packets reach it they're already clear, since the mux filter ran
+ * first.
+ *
+ * Activation is driven from `cac_start` (mirroring dvbcam): when a service
+ * with a B-CAS CAID in its PMT starts, install / refcount the per-mux
+ * libaribb25 instance and register the per-service descrambler. The
+ * `cac_caid_update` callback only fires for CAT-derived EMM CAIDs, which is
+ * not enough for ARIB ISDB activation.
+ * ***********************************************************************/
+
+/*
+ * No-op ECM section callback. libaribb25 parses ECMs from the raw TS itself;
+ * we only need descrambler_open_pid to subscribe the ECM PIDs so the demux
+ * actually delivers those packets into the mux's TS stream.
+ */
+static void
+aribb25_ecm_section_cb
+  ( void *opaque, int pid, const uint8_t *data, int len, int emm )
+{
+}
+
+static void
+aribb25_service_destroy ( th_descrambler_t *td )
+{
+  aribb25_descrambler_t *ad = (aribb25_descrambler_t *)td;
+  aribb25_mux_t         *am = ad->ad_mux_state;
+  int                    i;
+
+  if (ad->ad_mux) {
+    for (i = 0; i < ad->ad_ecm_pids.count; i++)
+      descrambler_close_pid(ad->ad_mux, ad,
+                            DESCRAMBLER_ECM_PID(ad->ad_ecm_pids.pids[i].pid));
+  }
+  mpegts_pid_done(&ad->ad_ecm_pids);
+
+  if (am) {
+    aribb25_t *ab = am->am_owner;
+    tvh_mutex_lock(&ab->ab_lock);
+    if (--am->am_refcount <= 0)
+      aribb25_mux_destroy(am);
+    tvh_mutex_unlock(&ab->ab_lock);
+  }
+
+  LIST_REMOVE(td, td_service_link);
+  free(td->td_nicename);
+  free(ad);
+}
+
+static void
+aribb25_service_start ( caclient_t *cac, struct service *t )
+{
+  aribb25_t                *ab = (aribb25_t *)cac;
+  th_descrambler_t         *td;
+  th_descrambler_runtime_t *dr;
+  elementary_stream_t      *st;
+  caid_t                   *c;
+  mpegts_service_t         *ms;
+  mpegts_mux_t             *mux;
+  aribb25_mux_t            *am;
+  aribb25_descrambler_t    *ad;
+  int                       found = 0;
+
+  if (!cac->cac_enabled)
+    return;
+
+  tvh_mutex_lock(&t->s_stream_mutex);
+
+  /* Does this service carry a B-CAS CAID? */
+  TAILQ_FOREACH(st, &t->s_components.set_all, es_link) {
+    if (st->es_type != SCT_CA) continue;
+    LIST_FOREACH(c, &st->es_caids, link) {
+      if (c->use && c->caid == ARIBB25_BCAS_CAID) {
+        found = 1;
+        break;
+      }
+    }
+    if (found) break;
+  }
+  if (!found) {
+    tvh_mutex_unlock(&t->s_stream_mutex);
+    return;
+  }
+
+  /* Already attached on this service? */
+  LIST_FOREACH(td, &t->s_descramblers, td_service_link) {
+    if (td->td_stop == aribb25_service_destroy) {
+      tvh_mutex_unlock(&t->s_stream_mutex);
+      return;
+    }
+  }
+
+  ms  = (mpegts_service_t *)t;
+  mux = ms->s_dvb_mux;
+  if (mux == NULL) {
+    tvh_mutex_unlock(&t->s_stream_mutex);
+    return;
+  }
+
+  /* Per-mux libaribb25 instance + packet filter (refcounted across services). */
+  tvh_mutex_lock(&ab->ab_lock);
+  am = aribb25_mux_find(ab, mux);
+  if (am == NULL)
+    am = aribb25_mux_create(ab, mux);
+  if (am != NULL)
+    am->am_refcount++;
+  tvh_mutex_unlock(&ab->ab_lock);
+  if (am == NULL) {
+    tvh_mutex_unlock(&t->s_stream_mutex);
+    return;
+  }
+
+  ad = calloc(1, sizeof(*ad));
+  ad->ad_mux_state = am;
+  ad->ad_mux       = mux;
+  mpegts_pid_init(&ad->ad_ecm_pids);
+  td               = (th_descrambler_t *)ad;
+  td->td_nicename  = strdup("aribb25");
+  td->td_service   = t;
+  td->td_stop      = aribb25_service_destroy;
+
+  /* Collect every ES with a matching CAID; its es_pid IS the ECM PID. */
+  TAILQ_FOREACH(st, &t->s_components.set_all, es_link) {
+    if (st->es_type != SCT_CA) continue;
+    LIST_FOREACH(c, &st->es_caids, link)
+      if (c->use && c->caid == ARIBB25_BCAS_CAID) {
+        mpegts_pid_add(&ad->ad_ecm_pids, st->es_pid, 0);
+        break;
+      }
+  }
+
+  dr = ms->s_descramble;
+  if (dr) {
+    dr->dr_descrambler = td;
+    dr->dr_descramble  = descrambler_pass;
+  }
+  descrambler_change_keystate(td, DS_READY, 0);
+  LIST_INSERT_HEAD(&t->s_descramblers, td, td_service_link);
+
+  tvh_mutex_unlock(&t->s_stream_mutex);
+
+  /*
+   * Subscribe the ECM PIDs on the mux so the DMX delivers them. Without this
+   * libaribb25 sees PAT+PMT+scrambled-ES but never an ECM, so its put() keeps
+   * returning WARN_ECM_NOT_COMPLETE; we'd emit no descrambled output until it
+   * eventually fails hard after buffering 32MB of input -- well past
+   * tvheadend's 20-second subscription start-up timeout.
+   */
+  {
+    int i;
+    for (i = 0; i < ad->ad_ecm_pids.count; i++)
+      descrambler_open_pid(mux, ad,
+                           DESCRAMBLER_ECM_PID(ad->ad_ecm_pids.pids[i].pid),
+                           aribb25_ecm_section_cb, t);
+  }
+
+  tvhinfo(LS_ARIBB25, "service %p: descrambler attached (mux=%p, ecms=%d)",
+          t, mux, ad->ad_ecm_pids.count);
+}
+
+static void
+aribb25_conf_changed ( caclient_t *cac )
+{
+  aribb25_t *ab = (aribb25_t *)cac;
+
+  /* Tear down all per-mux state. Future cac_caid_update notifications will
+   * rebuild it with the new configuration. */
+  tvh_mutex_lock(&ab->ab_lock);
+  aribb25_destroy_all_muxes(ab);
+  tvh_mutex_unlock(&ab->ab_lock);
+
+  if (cac->cac_enabled)
+    caclient_set_status(cac, CACLIENT_STATUS_READY);
+  else
+    caclient_set_status(cac, CACLIENT_STATUS_NONE);
+}
+
+static void
+aribb25_free ( caclient_t *cac )
+{
+  aribb25_t *ab = (aribb25_t *)cac;
+
+  tvh_mutex_lock(&ab->ab_lock);
+  aribb25_destroy_all_muxes(ab);
+  tvh_mutex_unlock(&ab->ab_lock);
+
+  free(ab->ab_cobalt_card_image_path);
+  tvh_mutex_destroy(&ab->ab_lock);
+}
+
+/* ************************************************************************
+ * Class
+ * ***********************************************************************/
+
+static htsmsg_t *
+aribb25_class_backend_list ( void *o, const char *lang )
+{
+  static const struct strtab tab[] = {
+    { N_("CobaltCas (software Blue Card emulator)"), ARIBB25_BACKEND_COBALT },
+    { N_("PC/SC (physical B-CAS card)"),             ARIBB25_BACKEND_PCSC   },
+  };
+  return strtab2htsmsg(tab, 1, lang);
+}
