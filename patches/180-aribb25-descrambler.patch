+/* ************************************************************************
+ * Construction
+ * ***********************************************************************/
+
+caclient_t *
+aribb25_create ( void )
+{
+  aribb25_t *ab = calloc(1, sizeof(*ab));
+
+  ab->ab_card_backend  = ARIBB25_BACKEND_COBALT;
+  ab->ab_process_emm   = 0;
+  ab->ab_multi2_round  = 4;
+  ab->ab_cobalt_log_mode = 0;
+  LIST_INIT(&ab->ab_muxes);
+  tvh_mutex_init(&ab->ab_lock, NULL);
+
+  ((caclient_t *)ab)->cac_free         = aribb25_free;
+  ((caclient_t *)ab)->cac_start        = aribb25_service_start;
+  ((caclient_t *)ab)->cac_conf_changed = aribb25_conf_changed;
+  return (caclient_t *)ab;
+}
