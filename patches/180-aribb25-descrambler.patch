--- /dev/null
+++ b/src/descrambler/aribb25.c
@@ -0,0 +1,662 @@
+/*
+ *  Tvheadend - ARIB STD-B25 descrambler via libaribb25
+ *
+ *  Wraps libaribb25 as a CA client. libaribb25 is monolithic - it eats whole
+ *  TS, parses ECM/PMT internally, talks to a B-CAS card (physical via PC/SC,
+ *  or software-emulated via CobaltCas), and emits descrambled TS. So instead
+ *  of supplying control words to tvheadend's tvhcsa, the CA client owns a
+ *  per-mux libaribb25 instance and registers itself as the mux's
+ *  `mm_filter_packets` hook, which runs early in mpegts_input_recv_packets.
+ *
+ *  This program is free software: you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation, either version 3 of the License, or
+ *  (at your option) any later version.
