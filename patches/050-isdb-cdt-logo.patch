+/*
+ * CDT (Common Data Table) - PID 0x29, table_id 0xC8.
+ *
+ * Carries ISDB station logos. Each section holds one self-contained logo
+ * data module of a distinct logo_type; only logo_type 0x05 (the standard
+ * receiver logo) is kept.
+ */
+static int
+dvb_cdt_callback ( mpegts_table_t *mt, const uint8_t *ptr, int len, int tableid )
+{
+  int r, sect, last, ver, seclen, total, dll, dmlen, data_size;
+  uint16_t download_data_id, onid, logo_id;
+  const uint8_t *dm;
+  mpegts_psi_table_state_t *st = NULL;
+
+  if (tableid != DVB_CDT_BASE || len < 24)
+    return -1;
+  download_data_id = extract_2byte(ptr + 3);
+  r = dvb_table_begin((mpegts_psi_table_t *)mt, ptr, len, tableid,
+                      download_data_id, 13, &st, &sect, &last, &ver, 0);
+  if (r != 1)
+    return r;
+
+  seclen = ((ptr[1] & 0x0f) << 8) | ptr[2];
+  total  = seclen + 3;
+  if (total > len || total < 24)
+    goto done;
+
+  onid = extract_2byte(ptr + 8);
+  dll  = ((ptr[11] & 0x0f) << 8) | ptr[12];
+  if (ptr[10] != 0x01 || 13 + dll + 7 + 4 > total)   /* data_type 0x01 = logo */
+    goto done;
+
+  dm    = ptr + 13 + dll;
+  dmlen = total - 4 - (13 + dll);
+
+  /* logo data module: logo_type(8) res(7) logo_id(9) res(4) logo_version(12)
+   *                    data_size(16) data_byte[] */
+  logo_id   = ((dm[1] & 0x01) << 8) | dm[2];
+  data_size = extract_2byte(dm + 5);
+  if (dm[0] == 0x05 && data_size > 33 && 7 + data_size <= dmlen) {
+    isdb_logo_save(onid, logo_id, dm + 7, data_size);
+    isdb_logo_apply_network(mt->mt_mux, onid, logo_id);
+  }
+
+done:
+  return dvb_table_end((mpegts_psi_table_t *)mt, st, sect);
+}
