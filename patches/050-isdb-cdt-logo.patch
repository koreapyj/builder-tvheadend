+
+/* Absolute path of the logo PNG file for (onid, logo_id). */
+static int
+isdb_logo_filename ( char *dst, size_t dstlen, uint16_t onid, uint16_t logo_id )
+{
+  return hts_settings_buildpath(dst, dstlen, "isdb_logos/%u_%u.png",
+                                onid, logo_id);
+}
+
+/* Reconstruct the PNG (header + PLTE + tRNS + IDAT/IEND) and write it. */
+static void
+isdb_logo_save ( uint16_t onid, uint16_t logo_id, const uint8_t *data, int len )
+{
+  char path[PATH_MAX];
+  FILE *fp;
+
+  if (len < 33)
+    return;
+  if (isdb_logo_filename(path, sizeof(path), onid, logo_id))
+    return;
+  hts_settings_makedirs(path);
+  if ((fp = fopen(path, "wb")) == NULL)
+    return;
+  fwrite(data, 1, 33, fp);
+  fwrite(isdb_logo_plte, 1, sizeof(isdb_logo_plte), fp);
+  fwrite(isdb_logo_trns, 1, sizeof(isdb_logo_trns), fp);
+  fwrite(data + 33, 1, len - 33, fp);
+  fclose(fp);
+  tvhinfo(LS_TBL_BASE, "isdb: logo onid %04X id %u saved (%s)",
+          onid, logo_id, path);
+}
+
+/*
+ * If the logo file for this service exists, set it as the icon of any of
+ * the service's channels that has no icon. A user-set icon is never
+ * overwritten.
+ */
+static void
+isdb_logo_apply ( mpegts_service_t *s )
+{
+  char path[PATH_MAX], url[PATH_MAX + 8];
+  idnode_list_mapping_t *ilm;
+  channel_t *ch;
+
+  if (s == NULL || s->s_dvb_logo_id == 0 || s->s_dvb_mux == NULL)
+    return;
+  if (isdb_logo_filename(path, sizeof(path),
+                         s->s_dvb_mux->mm_onid, s->s_dvb_logo_id))
+    return;
+  if (access(path, R_OK))
+    return;  /* logo not extracted yet */
+  snprintf(url, sizeof(url), "file://%s", path);
+  LIST_FOREACH(ilm, &s->s_channels, ilm_in1_link) {
+    ch = (channel_t *)ilm->ilm_in2;
+    if (ch->ch_icon && ch->ch_icon[0])
+      continue;
+    if (channel_set_icon(ch, url))
+      idnode_changed(&ch->ch_id);
+  }
+}
+
+/* Apply a freshly-saved logo to every matching service on the network. */
+static void
+isdb_logo_apply_network ( mpegts_mux_t *mm, uint16_t onid, uint16_t logo_id )
+{
+  mpegts_mux_t *m;
+  mpegts_service_t *s;
+
+  LIST_FOREACH(m, &mm->mm_network->mn_muxes, mm_network_link) {
+    if (m->mm_onid != onid)
+      continue;
+    LIST_FOREACH(s, &m->mm_services, s_dvb_mux_link)
+      if (s->s_dvb_logo_id == logo_id)
+        isdb_logo_apply(s);
+  }
+}
