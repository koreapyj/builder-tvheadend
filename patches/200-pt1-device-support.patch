+static void *
+pt1_frontend_input_thread ( void *aux )
+{
+  pt1_frontend_t *lfe = aux;
+  mpegts_mux_instance_t *mmi;
+  char name[256];//, b;
+  //tvhpoll_event_t ev[2];
+  //tvhpoll_t *efd;
+  ssize_t n;
+  size_t skip = (MIN(lfe->pfe_skip_bytes, 1024*1024) / 188) * 188;
+  size_t counter = 0;
+  sbuf_t sb;
+  int dvr = -1;//, nfds;//, nodata = 4;
+
+  /* Get MMI */
+  tvh_mutex_lock(&lfe->pfe_dvr_lock);
+  lfe->mi_display_name((mpegts_input_t*)lfe, name, sizeof(name));
+  mmi = LIST_FIRST(&lfe->mi_mux_active);
+  tvh_cond_signal(&lfe->pfe_dvr_cond, 0);
+  tvh_mutex_unlock(&lfe->pfe_dvr_lock);
+
+  if (mmi == NULL) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s mmi NULL", name);
+    return NULL;
+  }
+  
+  dvr = pt1_frontend_open_fd(lfe, name);
+  if (dvr <= 0) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    return NULL;
+  }
+
+  if ((ioctl(dvr, STOP_REC, NULL)) != 0 &&
+    errno != EALREADY) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s - STOP_REC failed [e=%s]", name, strerror(errno));
+    pt1_frontend_close_fd(lfe, name);
+    return NULL;
+  }
+
+  uint32_t feFreq = ((dvb_mux_t*)mmi->mmi_mux)->lm_tuning.dmc_fe_freq;
+  tvhtrace(LS_PT1, "tuner %s tuning to (freq %i)", name, feFreq);
+
+  if (ioctl(dvr, PTX_SET_SYSTEM_MODE, lfe->pfe_type == DVB_TYPE_ISDB_T ? 16 : 32) != 0)
+  {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s - PTX_SET_SYSTEM_MODE failed %s", name, strerror(errno));
+    pt1_frontend_close_fd(lfe, name);
+    return NULL;
+  }
+
+  FREQUENCY freq;
+  {
+    dvb_mux_t *dm = (dvb_mux_t*)mmi->mmi_mux;
+    if (pt1_resolve_freq(dm->lm_tuning.dmc_fe_freq,
+                         dm->lm_tuning.dmc_fe_stream_id,
+                         lfe->pfe_type, &freq) != 0) {
+      lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+      tvherror(LS_PT1, "%s - invalid channel", name);
+      pt1_frontend_close_fd(lfe, name);
+      return NULL;
+    }
+  }
+
+  if (lfe->pfe_type == DVB_TYPE_ISDB_S) {
+    int value = lfe->pfe_lnb_voltage;
+    tvhtrace(LS_PT1, "%s - LNB_ENABLE %d", name, value);
+    if(ioctl(dvr, LNB_ENABLE, value) != 0) {
+      tvherror(LS_PT1, "%s - LNB_ENABLE failed [e=%s]", name, strerror(errno));
+      lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+      pt1_frontend_close_fd(lfe, name);
+      return NULL;
+    }
+  }
+
+  tvhtrace(LS_PT1, "%s - tuning fno=%d slot=%d", name, freq.frequencyno, freq.slot);
+  if (ioctl(lfe->pfe_fd, SET_CHANNEL, &freq) != 0)
+  {
+    tvherror(LS_PT1, "%s - SET_CHANNEL failed [e=%s]", name, strerror(errno));
+    if (errno != EAGAIN) {
+      lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+      pt1_frontend_close_fd(lfe, name);
+      return NULL;
+    }
+  }
+
+  if ((ioctl(dvr, START_REC, NULL)) != 0) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s - START_REC failed [e=%s]", name, strerror(errno));
+    pt1_frontend_close_fd(lfe, name);
+    return NULL;
+  }
+
+  /* Allocate memory */
+  sbuf_init_fixed(&sb, MINMAX(lfe->pfe_ibuf_size, 18800, 1880000));
+  
+  lfe->pfe_in_setup = 0;
+
+  tvhtrace(LS_PT1, "start!");
+  
+  /* Read */
+  while (tvheadend_is_running() && lfe->pfe_thread_running) {    
+    /* Read */
+    if ((n = sbuf_read(&sb, dvr)) < 0) {
+      if (ERRNO_AGAIN(errno))
+        continue;
+      if (errno == EOVERFLOW) {
+        tvhwarn(LS_PT1, "%s - read() EOVERFLOW", name);
+        continue;
+      }
+      tvherror(LS_PT1, "%s - read() error %d (%s)",
+               name, errno, strerror(errno));
+      break;
+    }
+
+    /* Skip the initial bytes */
+    if (counter < skip) {
+      counter += n;
+      if (counter < skip) {
+        sbuf_cut(&sb, n);
+      } else {
+        sbuf_cut(&sb, skip - (counter - n));
+      }
+    }
+    
+    /* Process */
+    mpegts_input_recv_packets(mmi, &sb, 0, NULL);
+  }
+  
+  sbuf_free(&sb);
+  lfe->pfe_dvr_error = SM_CODE_ABORTED;
+  pt1_frontend_close_fd(lfe, name);
+  return NULL;
+}
+
