+static void
+pt1_frontend_save ( pt1_frontend_t *lfe, htsmsg_t *fe )
+{
+  char id[16];
+  htsmsg_t *m = htsmsg_create_map();
+
+  /* Save frontend */
+  mpegts_input_save((mpegts_input_t*)lfe, m);
+  htsmsg_add_s32(m, "type", lfe->pfe_type);
+  htsmsg_add_uuid(m, "uuid", &lfe->ti_id.in_uuid);
+
+  /* Add to list */
+  snprintf(id, sizeof(id), "Frontend %d", lfe->pfe_type);
+  htsmsg_add_msg(fe, id, m);
+}
+
+
+static htsmsg_t *
+pt1_adapter_class_save ( idnode_t *in, char *filename, size_t fsize )
+{
+  pt1_adapter_t *la = (pt1_adapter_t*)in;
+  htsmsg_t *m, *l;
+
+  char ubuf[UUID_HEX_SIZE];
+
+  m = htsmsg_create_map();
+  idnode_save(&la->th_id, m);
+
+  if (filename) {
+    /* Frontends */
+    l = htsmsg_create_map();
+    pt1_frontend_save(la->pt_frontend, l);
+    htsmsg_add_msg(m, "frontends", l);
+
+    /* Filename */
+    snprintf(filename, fsize, "input/pt1/adapters/%s",
+             idnode_uuid_as_str(&la->th_id, ubuf));
+  }
+  return m;
+}
