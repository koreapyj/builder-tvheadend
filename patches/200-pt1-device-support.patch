+static void
+pt1_frontend_close_fd ( pt1_frontend_t *lfe, const char *name )
+{
+  char buf[256];
+  int fd = atomic_exchange(&lfe->pfe_fd, -1);
+  if (fd <= 0)
+    return;
+
+  if (name == NULL) {
+    lfe->mi_display_name((mpegts_input_t *)lfe, buf, sizeof(buf));
+    name = buf;
+  }
+
+  tvhtrace(LS_PT1, "%s - closing FE %s",
+           name, lfe->pfe_adapter->pt_rootpath);
+  close(fd);
+}
+
+static int
+pt1_frontend_open_fd ( pt1_frontend_t *lfe, const char *name )
+{
+  if (lfe->pfe_fd > 0)
+    return lfe->pfe_fd;
+
+  int fd = tvh_open(lfe->pfe_adapter->pt_rootpath, O_RDONLY/* | O_NONBLOCK*/, 0);
+  if (fd <= 0)
+    return fd;
+
+  int oldfd = atomic_exchange(&lfe->pfe_fd, fd);
+  if (oldfd > 0)
+    close(oldfd);
+
+  tvhtrace(LS_PT1, "%s - opening FE %s (%d)",
+           name, lfe->pfe_adapter->pt_rootpath, fd);
+
+  return lfe->pfe_fd;
+}
+
+
+static void
+pt1_frontend_enabled_updated ( mpegts_input_t *mi )
+{
+  char buf[512];
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+
+  mi->mi_display_name(mi, buf, sizeof(buf));
+
+  /* Ensure disabled */
+  if (!mi->mi_enabled) {
+    tvhtrace(LS_PT1, "%s - disabling tuner", buf);
+    pt1_frontend_close_fd(lfe, buf);
+    mtimer_disarm(&lfe->pfe_monitor_timer);
+
+  /* Ensure FE opened (if not powersave) */
+  }
+}
