+
+typedef struct pt1_adapter     pt1_adapter_t;
+typedef struct pt1_frontend     pt1_frontend_t;
+
+struct pt1_adapter
+{
+  tvh_hardware_t;
+
+  /*
+   * Adapter info
+   */
+  char    *pt_name;
+  char    *pt_rootpath;
+  /* Up to two frontends per chardev (ISDB-T and/or ISDB-S). Unified
+   * chardevs host both; hardwired ones leave the unused slot NULL. */
+  pt1_frontend_t *pt_fe[2];      /* indexed by PT1_FE_T / PT1_FE_S */
+  pt1_frontend_t *pt_busy_fe;    /* whichever frontend holds the chardev
+                                    fd right now, or NULL */
+  tvh_mutex_t     pt_busy_lock;  /* guards pt_busy_fe */
+};
+
+#define PT1_FE_T 0
+#define PT1_FE_S 1
+#define PT1_FE_SLOT(type)  ((type) == DVB_TYPE_ISDB_T ? PT1_FE_T : PT1_FE_S)
+
+struct pt1_frontend
+{
+  mpegts_input_t;
+  pt1_adapter_t *pfe_adapter;
+  dvb_fe_type_t pfe_type;
+  volatile int pfe_fd;
+
+  uint32_t pfe_thread_started;
+  volatile uint32_t pfe_thread_running;
+  pthread_t                 pfe_dvr_thread;
+  tvh_mutex_t           pfe_dvr_lock;
+  tvh_cond_t                pfe_dvr_cond;
+  volatile int32_t pfe_dvr_error;
+
+  uint32_t                  pfe_skip_bytes;
+  uint32_t                  pfe_ibuf_size;
+
+  int64_t                   pfe_monitor;
+  mtimer_t                  pfe_monitor_timer;
+
+  uint32_t pfe_ready;
+  volatile uint32_t pfe_in_setup;
+  uint32_t pfe_locked;
+
+  uint32_t pfe_status_period;
+
+  int pfe_lnb_voltage;
+
+  /* one-shot warning for SET_PID_FILTER unsupported; reset on each
+   * pt1_frontend_open_fd so a fresh tune gets a fresh chance to log */
+  uint8_t pfe_warned_pid_filter;
+
+  /* Cache of the PID set most recently pushed to the chardev. We skip
+   * identical SET_PID_FILTER calls so we don't disturb the data flow
+   * with redundant IT930x i2c register writes; the framework triggers
+   * mi_update_pids on every mm_pids touch and many of those touches
+   * leave the PID list unchanged.
+   * pfe_last_n == -1 means "no filter applied yet" (state on first
+   * tune or after open_fd resets us). */
+  int      pfe_last_n;
+  uint8_t  pfe_last_pass;
+  uint16_t pfe_last_pids[64];   /* PTX_PID_FILTER_MAX_PIDS */
+};
+
