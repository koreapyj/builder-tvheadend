+/* Forward declarations for helpers used before their definition. */
+static void pt1_input_update_pids(mpegts_input_t *mi, mpegts_mux_t *mm);
+
+static void
+pt1_frontend_save ( pt1_frontend_t *lfe, htsmsg_t *fe )
+{
+  char id[16];
+  htsmsg_t *m = htsmsg_create_map();
+
+  /* Save frontend */
+  mpegts_input_save((mpegts_input_t*)lfe, m);
+  htsmsg_add_s32(m, "type", lfe->pfe_type);
+  htsmsg_add_uuid(m, "uuid", &lfe->ti_id.in_uuid);
+
+  /* Add to list */
+  snprintf(id, sizeof(id), "Frontend %d", lfe->pfe_type);
+  htsmsg_add_msg(fe, id, m);
+}
+
+
+static htsmsg_t *
+pt1_adapter_class_save ( idnode_t *in, char *filename, size_t fsize )
+{
+  pt1_adapter_t *la = (pt1_adapter_t*)in;
+  htsmsg_t *m, *l;
+
+  char ubuf[UUID_HEX_SIZE];
+
+  m = htsmsg_create_map();
+  idnode_save(&la->th_id, m);
+
+  if (filename) {
+    /* Frontends — one submap per delsys, mirroring linuxdvb's layout. */
+    int i;
+    l = htsmsg_create_map();
+    for (i = 0; i < 2; i++)
+      if (la->pt_fe[i]) pt1_frontend_save(la->pt_fe[i], l);
+    htsmsg_add_msg(m, "frontends", l);
+
+    /* Filename */
+    snprintf(filename, fsize, "input/pt1/adapters/%s",
+             idnode_uuid_as_str(&la->th_id, ubuf));
+  }
+  return m;
+}
+
+
+static void
+pt1_adapter_class_get_title
+  ( idnode_t *in, const char *lang, char *dst, size_t dstsize )
+{
+  pt1_adapter_t *la = (pt1_adapter_t*)in;
+  /* Mirror linuxdvb_adapter_class_get_title: "<rootpath> [<name>]" so
+   * the operator sees both the chardev they're configuring and the
+   * resolved hardware label. */
+  if (la->pt_name && la->pt_rootpath)
+    snprintf(dst, dstsize, "%s [%s]", la->pt_rootpath, la->pt_name);
+  else
+    snprintf(dst, dstsize, "%s", la->pt_rootpath ?: (la->pt_name ?: ""));
+}
+
+static const void *
+pt1_adapter_class_active_get ( void *obj )
+{
+  pt1_adapter_t *la = (pt1_adapter_t*)obj;
+  static int active = 0;
+  int i;
+  active = 0;
+  for (i = 0; i < 2; i++) {
+    pt1_frontend_t *fe = la->pt_fe[i];
+    if (fe && fe->mi_is_enabled((mpegts_input_t*)fe, NULL, 0, -1) != MI_IS_ENABLED_NEVER) {
+      active = 1;
+      break;
+    }
+  }
+  return &active;
+}
+
+static idnode_set_t *
+pt1_adapter_class_get_childs ( idnode_t *in )
+{
+  pt1_adapter_t *la = (pt1_adapter_t*)in;
+  idnode_set_t *is = idnode_set_create(0);
+  int i;
+  for (i = 0; i < 2; i++)
+    if (la->pt_fe[i]) idnode_set_add(is, &la->pt_fe[i]->ti_id, NULL, NULL);
+  return is;
+}
