+static mpegts_network_t *
+pt1_frontend_wizard_network ( pt1_frontend_t *lfe )
+{
+  return (mpegts_network_t *)LIST_FIRST(&lfe->mi_networks);
+}
+
+static htsmsg_t *
+pt1_frontend_wizard_get( tvh_input_t *ti, const char *lang )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t*)ti;
+  mpegts_network_t *mn;
+  const idclass_t *idc = NULL;
+
+  mn = pt1_frontend_wizard_network(lfe);
+  if ((mn == NULL) || (mn && mn->mn_wizard)) {
+    idc = pt1_get_id_class_by_type(lfe->pfe_type);
+  }
+  return mpegts_network_wizard_get((mpegts_input_t *)lfe, idc, mn, lang);
+}
+
+static void
+pt1_frontend_wizard_set( tvh_input_t *ti, htsmsg_t *conf, const char *lang )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t*)ti;
+  const char *ntype = htsmsg_get_str(conf, "mpegts_network_type");
+  mpegts_network_t *mn;
+  htsmsg_t *nlist;
+
+  if (LIST_FIRST(&lfe->mi_mux_active))
+    return;
+  mpegts_network_wizard_create(ntype, &nlist, lang);
+  mn = pt1_frontend_wizard_network(lfe);
+  if (ntype && (mn == NULL || mn->mn_wizard)) {
+    mpegts_input_set_networks((mpegts_input_t *)lfe, nlist);
+    htsmsg_destroy(nlist);
+
+    if (pt1_frontend_wizard_network(lfe))
+      mpegts_input_set_enabled((mpegts_input_t *)lfe, 1);
+    pt1_adapter_changed(lfe->pfe_adapter);
+  } else {
+    htsmsg_destroy(nlist);
+  }
+}
+
+static idnode_set_t *
+pt1_frontend_network_list ( mpegts_input_t *mi )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+
+  tvhtrace(LS_PT1, "%s: network list for %d",
+           mi->mi_name ?: "", lfe->pfe_type);
+
+  const idclass_t *idc = NULL;
+  idc = dvb_network_class_by_fe_type(lfe->pfe_type);
+  if (idc == NULL) return NULL;
+
+  return idnode_find_all(idc, NULL);
+}
+
+static void *
+pt1_frontend_input_thread ( void *aux )
+{
+  pt1_frontend_t *lfe = aux;
+  mpegts_mux_instance_t *mmi;
+  char name[256];//, b;
+  //tvhpoll_event_t ev[2];
+  //tvhpoll_t *efd;
+  ssize_t n;
+  size_t skip = (MIN(lfe->pfe_skip_bytes, 1024*1024) / 188) * 188;
+  size_t counter = 0;
+  sbuf_t sb;
+  int dvr = -1;//, nfds;//, nodata = 4;
+
+  /* Get MMI */
+  tvh_mutex_lock(&lfe->pfe_dvr_lock);
+  lfe->mi_display_name((mpegts_input_t*)lfe, name, sizeof(name));
+  mmi = LIST_FIRST(&lfe->mi_mux_active);
+  tvh_cond_signal(&lfe->pfe_dvr_cond, 0);
+  tvh_mutex_unlock(&lfe->pfe_dvr_lock);
+
+  if (mmi == NULL) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s mmi NULL", name);
+    return NULL;
+  }
+  
+  dvr = pt1_frontend_open_fd(lfe, name);
+  if (dvr <= 0) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    return NULL;
+  }
+
+  if ((ioctl(dvr, STOP_REC, NULL)) != 0 &&
+    errno != EALREADY) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s - STOP_REC failed [e=%s]", name, strerror(errno));
+    pt1_frontend_close_fd(lfe, name);
+    return NULL;
+  }
+
+  uint32_t feFreq = ((dvb_mux_t*)mmi->mmi_mux)->lm_tuning.dmc_fe_freq;
+  tvhtrace(LS_PT1, "tuner %s tuning to (freq %i)", name, feFreq);
+
+  if (ioctl(dvr, PTX_SET_SYSTEM_MODE, lfe->pfe_type == DVB_TYPE_ISDB_T ? 16 : 32) != 0)
+  {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s - PTX_SET_SYSTEM_MODE failed %s", name, strerror(errno));
+    pt1_frontend_close_fd(lfe, name);
+    return NULL;
+  }
+
+  FREQUENCY freq;
+  {
+    dvb_mux_t *dm = (dvb_mux_t*)mmi->mmi_mux;
+    if (pt1_resolve_freq(dm->lm_tuning.dmc_fe_freq,
+                         dm->lm_tuning.dmc_fe_stream_id,
+                         lfe->pfe_type, &freq) != 0) {
+      lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+      tvherror(LS_PT1, "%s - invalid channel", name);
+      pt1_frontend_close_fd(lfe, name);
+      return NULL;
+    }
+  }
+
+  if (lfe->pfe_type == DVB_TYPE_ISDB_S) {
+    int value = lfe->pfe_lnb_voltage;
+    tvhtrace(LS_PT1, "%s - LNB_ENABLE %d", name, value);
+    if(ioctl(dvr, LNB_ENABLE, value) != 0) {
+      tvherror(LS_PT1, "%s - LNB_ENABLE failed [e=%s]", name, strerror(errno));
+      lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+      pt1_frontend_close_fd(lfe, name);
+      return NULL;
+    }
+  }
+
+  tvhtrace(LS_PT1, "%s - tuning fno=%d slot=%d", name, freq.frequencyno, freq.slot);
+  if (ioctl(lfe->pfe_fd, SET_CHANNEL, &freq) != 0)
+  {
+    tvherror(LS_PT1, "%s - SET_CHANNEL failed [e=%s]", name, strerror(errno));
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    pt1_frontend_close_fd(lfe, name);
+    return NULL;
+  }
+
+  /* Pre-arm the hardware PID filter BEFORE START_REC so the chip's
+   * OFF->PASS mode flip happens while no data is flowing yet. If we
+   * let the first SET_PID_FILTER fire later from mi_update_pids on
+   * the input thread's first packet instead, the OFF->PASS mode
+   * register write drops the one in-flight video packet and tvheadend
+   * reports a spurious CC error.
+   *
+   * mm_pids is already populated by psi_tables_install (PAT/CAT/NIT/
+   * SDT/BAT/EIT/TDT/CDT all opened during start_mux), so the filter
+   * we install here has the full essential-PSI set. We hold
+   * mi_output_lock and clear mm_update_pids_flag the same way the
+   * framework's mpegts_mux_update_pids_cb does. */
+  {
+    mpegts_input_t *mi = (mpegts_input_t *)lfe;
+    mpegts_mux_t   *mm = mmi->mmi_mux;
+    tvh_mutex_lock(&mi->mi_output_lock);
+    mm->mm_update_pids_flag = 0;
+    pt1_input_update_pids(mi, mm);
+    tvh_mutex_unlock(&mi->mi_output_lock);
+  }
+
+  if ((ioctl(dvr, START_REC, NULL)) != 0) {
+    lfe->pfe_dvr_error = SM_CODE_TUNING_FAILED;
+    tvherror(LS_PT1, "%s - START_REC failed [e=%s]", name, strerror(errno));
+    pt1_frontend_close_fd(lfe, name);
+    return NULL;
+  }
+
+  /* Allocate memory */
+  sbuf_init_fixed(&sb, MINMAX(lfe->pfe_ibuf_size, 18800, 1880000));
+  
+  lfe->pfe_in_setup = 0;
+
+  tvhtrace(LS_PT1, "start!");
+  
+  /* Read */
+  while (tvheadend_is_running() && lfe->pfe_thread_running) {    
+    /* Read */
+    if ((n = sbuf_read(&sb, dvr)) < 0) {
+      if (ERRNO_AGAIN(errno))
+        continue;
+      if (errno == EOVERFLOW) {
+        tvhwarn(LS_PT1, "%s - read() EOVERFLOW", name);
+        continue;
+      }
+      tvherror(LS_PT1, "%s - read() error %d (%s)",
+               name, errno, strerror(errno));
+      break;
+    }
+    /* sbuf_read returns 0 both on kernel EOF (STOP_REC) and when our sbuf
+     * was full so read() was called with size 0. We can't disambiguate
+     * here, so don't bail on n == 0: the STOP_REC path still exits via
+     * the while-head check (stop_mux sets pfe_thread_running = 0 before
+     * the ioctl); the sbuf-full path falls through to recv_packets which
+     * drains so the next sbuf_read can resume. */
+
+    /* Skip the initial bytes */
+    if (counter < skip) {
+      counter += n;
+      if (counter < skip) {
+        sbuf_cut(&sb, n);
+      } else {
+        sbuf_cut(&sb, skip - (counter - n));
+      }
+    }
+    
+    /* Process */
+    mpegts_input_recv_packets(mmi, &sb, 0, NULL);
+  }
+  
+  sbuf_free(&sb);
+  lfe->pfe_dvr_error = SM_CODE_ABORTED;
+  pt1_frontend_close_fd(lfe, name);
+  return NULL;
+}
+
+
+
+static void
+pt1_frontend_monitor ( void *aux )
+{
+  char buf[256];
+  pt1_frontend_t *lfe = aux;
+  mpegts_mux_instance_t *mmi = LIST_FIRST(&lfe->mi_mux_active);
+  mpegts_mux_t *mm;
+  signal_status_t sigstat;
+  streaming_message_t sm;
+  service_t *s;
+  int e;
+  uint32_t period = MINMAX(lfe->pfe_status_period, 250, 8000);
+  signal_status_scale_t snr_scale = SIGNAL_STATUS_SCALE_UNKNOWN;
+  int snr = 0;
+  int dvr = -1;
+
+  lfe->mi_display_name((mpegts_input_t*)lfe, buf, sizeof(buf));
+  tvhtrace(LS_PT1, "%s - checking FE status %d/%d/%d error:%d", buf, lfe->mi_enabled, lfe->pfe_ready, lfe->pfe_locked, lfe->pfe_dvr_error);
+  
+  /* Disabled */
+  if (!lfe->mi_enabled && mmi)
+    mmi->mmi_mux->mm_stop(mmi->mmi_mux, 1, SM_CODE_ABORTED);
+  //else if(lfe->pfe_dvr_error && mmi)
+  //  mmi->mmi_mux->mm_stop(mmi->mmi_mux, 1, lfe->pfe_dvr_error);
+
+  /* Stop timer */
+  if (!mmi || !lfe->pfe_ready) return;
+
+  /* re-arm */
+  mtimer_arm_rel(&lfe->pfe_monitor_timer, pt1_frontend_monitor, lfe, ms2mono(period));
+
+  /* Get current mux */
+  mm = mmi->mmi_mux;
+
+  /* Waiting for lock */
+  if (!lfe->pfe_locked) {
+    lfe->pfe_locked = 1;
+
+    tvh_mutex_lock(&lfe->pfe_dvr_lock);
+    if (lfe->pfe_thread_started == 0)
+    {
+      lfe->pfe_dvr_error = 0;
+      lfe->pfe_thread_started = 1;
+      lfe->pfe_thread_running = 1;
+      tvh_thread_create(&lfe->pfe_dvr_thread, NULL,
+                        pt1_frontend_input_thread, lfe, "lnxdvb-front");
+      do {
+        e = tvh_cond_wait(&lfe->pfe_dvr_cond, &lfe->pfe_dvr_lock);
+        if (e == ETIMEDOUT)
+          break;
+      } while (ERRNO_AGAIN(e));
+    }
+    else
+    {
+      tvherror(LS_PT1, "pfe_thread_started already?");
+    }
+    tvh_mutex_unlock(&lfe->pfe_dvr_lock);
+
+    /* Table handlers */
+    psi_tables_install((mpegts_input_t *)lfe, mm,
+                        ((dvb_mux_t *)mm)->lm_tuning.dmc_fe_delsys);
+  } else {
+    if (mclk() < lfe->pfe_monitor)
+      return;
+    lfe->pfe_monitor = mclk() + ms2mono(period);
+  }
+
+  dvr = lfe->pfe_fd;
+  if (dvr > 0 && !lfe->pfe_dvr_error) {
+    uint32_t raw = 0;
+    /*
+     * ioctl can transiently return -EINVAL on px4_drv chardevs when the
+     * kernel hasn't yet committed `current_system` (the SET_CHANNEL ↔
+     * tune+lock dance is racing the monitor). Log at trace only and leave
+     * the previous snr_scale/snr in place rather than blanking them.
+     */
+    if (ioctl(dvr, GET_SIGNAL_STRENGTH, &raw) != 0) {
+      tvhtrace(LS_PT1, "%s - GET_SIGNAL_STRENGTH failed [e=%s]",
+               buf, strerror(errno));
+    } else {
+      int mdb = pt1_cn_to_millibel(lfe->pfe_adapter->pt_rootpath,
+                                   lfe->pfe_type, raw);
+      tvhtrace(LS_PT1, "%s - CN raw=0x%x -> %d.%03d dB",
+               buf, raw, mdb / 1000, abs(mdb % 1000));
+      if (mdb != INT_MIN) {
+        snr = mdb;
+        snr_scale = SIGNAL_STATUS_SCALE_DECIBEL;
+      }
+    }
+  }
+
+
+  tvh_mutex_lock(&mmi->tii_stats_mutex);
+  mmi->tii_stats.signal_scale = SIGNAL_STATUS_SCALE_UNKNOWN;
+  mmi->tii_stats.signal = 0;
+  mmi->tii_stats.ec_bit = 0;
+  mmi->tii_stats.tc_bit = 0;
+  /* Only refresh snr stats when we got a fresh sample; a transient ioctl
+   * failure shouldn't wipe out the previous good reading. */
+  if (snr_scale != SIGNAL_STATUS_SCALE_UNKNOWN) {
+    mmi->tii_stats.snr_scale = snr_scale;
+    mmi->tii_stats.snr = snr;
+  }
+  mmi->tii_stats.tc_block = 0;
+
+  /* Send message */
+  sigstat.status_text  = "UNKNOWN";
+  sigstat.snr          = mmi->tii_stats.snr;
+  sigstat.signal       = mmi->tii_stats.signal;
+  sigstat.ber          = mmi->tii_stats.ber;
+  sigstat.unc          = atomic_get(&mmi->tii_stats.unc);
+  sigstat.signal_scale = mmi->tii_stats.signal_scale;
+  sigstat.snr_scale    = mmi->tii_stats.snr_scale;
+  sigstat.ec_bit       = mmi->tii_stats.ec_bit;
+  sigstat.tc_bit       = mmi->tii_stats.tc_bit;
+  sigstat.ec_block     = mmi->tii_stats.ec_block;
+  sigstat.tc_block     = mmi->tii_stats.tc_block;
+  memset(&sm, 0, sizeof(sm));
+  sm.sm_type = SMT_SIGNAL_STATUS;
+  sm.sm_data = &sigstat;
+
+  tvh_mutex_unlock(&mmi->tii_stats_mutex);
+
+  LIST_FOREACH(s, &mmi->mmi_mux->mm_transports, s_active_link) {
+    tvh_mutex_lock(&s->s_stream_mutex);
+    streaming_service_deliver(s, streaming_msg_clone(&sm));
+    tvh_mutex_unlock(&s->s_stream_mutex);
+  }
+}
+
+
+static int
+pt1_frontend_start_mux
+  ( mpegts_input_t *mi, mpegts_mux_instance_t *mmi, int weight )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+  char buf1[256];
+
+  lfe->mi_display_name((mpegts_input_t*)lfe, buf1, sizeof(buf1));
+  {
+    dvb_mux_t *dm = (dvb_mux_t*)mmi->mmi_mux;
+    FREQUENCY probe;
+    if (pt1_resolve_freq(dm->lm_tuning.dmc_fe_freq,
+                         dm->lm_tuning.dmc_fe_stream_id,
+                         lfe->pfe_type, &probe) != 0) {
+      tvherror(LS_PT1, "%s - invalid freq: %s", buf1, mmi->mmi_mux->mm_nicename);
+      return SM_CODE_TUNING_FAILED;
+    }
+  }
+
+  tvhdebug(LS_PT1, "%s - starting %s", buf1, mmi->mmi_mux->mm_nicename);
+
+  lfe->pfe_ready = 1;
+  lfe->pfe_in_setup = 1;
+
+  /* Claim the chardev now so the sibling fe (on unified-chardev adapters)
+   * cannot be scheduled during the gap until pt1_frontend_monitor fires
+   * open_fd. open_fd re-asserts this idempotently. */
+  if (lfe->pfe_adapter) {
+    pt1_adapter_t *la = lfe->pfe_adapter;
+    tvh_mutex_lock(&la->pt_busy_lock);
+    la->pt_busy_fe = lfe;
+    tvh_mutex_unlock(&la->pt_busy_lock);
+  }
+
+  lfe->pfe_monitor = mclk() + sec2mono(4);
+  mtimer_arm_rel(&lfe->pfe_monitor_timer, pt1_frontend_monitor, lfe, ms2mono(50));
+  return 0;
+}
+
+
+static void
+pt1_frontend_stop_mux
+  ( mpegts_input_t *mi, mpegts_mux_instance_t *mmi )
+{
+  char buf1[256];
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+
+  mi->mi_display_name(mi, buf1, sizeof(buf1));
+  tvhdebug(LS_PT1, "%s - stopping %s", buf1, mmi->mmi_mux->mm_nicename);
+
+  /* Stop thread */
+  if (lfe->pfe_thread_started) {
+    int fd;
+    struct timespec ts;
+    int jr;
+
+    lfe->pfe_thread_running = 0;
+
+    /*
+     * Unblock the input thread's read() before joining. Without this the
+     * thread parks in the kernel ringbuffer's wait_event indefinitely on
+     * silent muxes; pthread_join then never returns and tvheadend's
+     * global_lock holder (the scan) stalls everything else.
+     *
+     * STOP_REC (= PTX_STOP_STREAMING) calls ringbuffer_stop + wake_up in
+     * the px4_drv chardev path, which is exactly what the reader's
+     * wait_event_interruptible condition checks (ringbuffer_is_running).
+     * The fd is owned by the input thread (it atomic_exchanges pfe_fd to
+     * -1 on its way out); a relaxed read here can race with that exit
+     * and land an ioctl on a closed fd -- kernel returns EBADF, harmless.
+     */
+    fd = lfe->pfe_fd;
+    if (fd > 0) {
+      if (ioctl(fd, STOP_REC, NULL) != 0)
+        tvhtrace(LS_PT1, "%s - STOP_REC (stop_mux) failed: %s",
+                 buf1, strerror(errno));
+      if (lfe->pfe_type == DVB_TYPE_ISDB_S)
+        (void)ioctl(fd, LNB_DISABLE, 0);
+    }
+
+    tvhtrace(LS_PT1, "%s - waiting for dvr thread", buf1);
+
+    /*
+     * Watchdog the join. If the driver ever fails to wake the reader
+     * (set_capture returned non-zero, so the kernel's wake_up was
+     * skipped), detach the stuck thread and keep tvheadend alive rather
+     * than freezing under global_lock.
+     */
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += 5;
+    jr = pthread_timedjoin_np(lfe->pfe_dvr_thread, NULL, &ts);
+    if (jr == ETIMEDOUT) {
+      tvherror(LS_PT1, "%s - dvr thread did not stop within 5s after STOP_REC; detaching",
+               buf1);
+      pthread_detach(lfe->pfe_dvr_thread);
+    } else if (jr != 0) {
+      tvhwarn(LS_PT1, "%s - pthread_timedjoin: %s", buf1, strerror(jr));
+    }
+    lfe->pfe_thread_started = 0;
+    tvhdebug(LS_PT1, "%s - stopped dvr thread", buf1);
+  }
+
+  lfe->pfe_dvr_error = 0;
+  lfe->pfe_locked = 0;
+  lfe->pfe_ready = 0;
+  lfe->pfe_in_setup = 0;
+
+  /* close_fd normally clears pt_busy_fe via the dvr thread, but if the
+   * thread was detached after a timed-out join it may never run. */
+  if (lfe->pfe_adapter) {
+    pt1_adapter_t *la = lfe->pfe_adapter;
+    tvh_mutex_lock(&la->pt_busy_lock);
+    if (la->pt_busy_fe == lfe) la->pt_busy_fe = NULL;
+    tvh_mutex_unlock(&la->pt_busy_lock);
+  }
+
+  mtimer_arm_rel(&lfe->pfe_monitor_timer, pt1_frontend_monitor, lfe, sec2mono(2));
+}
+
+
+/*
+ * Push the current mm_pids set down to the chardev as a hardware
+ * pass-list filter (px4_drv SET_PID_FILTER ioctl). Called from the
+ * mpegts framework whenever mm->mm_pids changes.
+ *
+ * By the time this fires for the first time, psi_tables_install has
+ * already synchronously added PAT/CAT/NIT/SDT/BAT/EIT/TDT/CDT via
+ * mpegts_table_add -> mpegts_input_open_pid, so essential PSI PIDs are
+ * already in mm_pids -- no manual union needed.
+ *
+ * Skips internal sentinel PIDs (MPEGTS_FULLMUX_PID / MPEGTS_TABLES_PID)
+ * and 0x1FFF (null packets). On overflow we disable the hardware filter
+ * and rely on the software demux. On ENOSYS/ENOTTY/EINVAL we warn once
+ * and proceed -- works against pre-Part-A px4_drv too.
+ */
+static int
+pt1_pid_cmp_u16 ( const void *a, const void *b )
+{
+  uint16_t x = *(const uint16_t *)a, y = *(const uint16_t *)b;
+  return (x > y) - (x < y);
+}
+
+static void
+pt1_input_update_pids ( mpegts_input_t *mi, mpegts_mux_t *mm )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t *)mi;
+  mpegts_mux_instance_t *mmi;
+  struct ptx_pid_filter f;
+  uint16_t pids[PTX_PID_FILTER_MAX_PIDS];
+  mpegts_pid_t *mp;
+  int n = 0;
+  int fd;
+  int i;
+  int disable = 0;
+
+  if (lfe == NULL)
+    return;
+  fd = lfe->pfe_fd;
+  if (fd <= 0)
+    return;
+  /* Only act on the mux we're currently tuned to. */
+  mmi = LIST_FIRST(&lfe->mi_mux_active);
+  if (!mmi || mm != mmi->mmi_mux)
+    return;
+
+  /* Collect the wanted PIDs. A full-mux subscription (sentinel
+   * MPEGTS_FULLMUX_PID present) or a set that exceeds the chip's
+   * slot count means we can't express the request as a PASS-mode
+   * filter — disable the hardware filter so every PID passes. */
+  RB_FOREACH(mp, &mm->mm_pids, mp_link) {
+    if (mp->mp_pid == MPEGTS_FULLMUX_PID) { disable = 1; break; }
+    if (mp->mp_pid == 0x1FFF) continue;
+    if (mp->mp_pid >= MPEGTS_FULLMUX_PID) continue;
+    if (n >= PTX_PID_FILTER_MAX_PIDS) { disable = 1; break; }
+    pids[n++] = mp->mp_pid;
+  }
+
+  if (disable) {
+    if (lfe->pfe_last_n == 0 && lfe->pfe_last_pass == 0)
+      return;  /* already disabled, nothing to do */
+    memset(&f, 0, sizeof(f));   /* num=0 -> driver disables filter */
+    (void)ioctl(fd, SET_PID_FILTER, &f);
+    lfe->pfe_last_n = 0;
+    lfe->pfe_last_pass = 0;
+    tvhinfo(LS_PT1, "pid-filter disabled");
+    return;
+  }
+
+  qsort(pids, n, sizeof(pids[0]), pt1_pid_cmp_u16);
+
+  /* Skip the ioctl if the resulting PID set is identical to what's
+   * already installed. The framework can fire mi_update_pids any time
+   * mm_pids is touched (e.g. when a PMT cycle re-confirms existing
+   * subscriptions); re-writing the same filter just costs i2c bus time
+   * on the IT930x and can disturb in-flight TS. */
+  if (lfe->pfe_last_n == n && lfe->pfe_last_pass == 1 &&
+      memcmp(lfe->pfe_last_pids, pids, n * sizeof(pids[0])) == 0) {
+    tvhtrace(LS_PT1, "pid-filter unchanged (%d pids), skipping ioctl", n);
+    return;
+  }
+
+  memset(&f, 0, sizeof(f));
+  f.pass = 1;
+  f.num  = (uint8_t)n;
+  for (i = 0; i < n; i++)
+    f.pid[i] = pids[i];
+
+  if (ioctl(fd, SET_PID_FILTER, &f) < 0) {
+    if (errno == ENOSYS || errno == ENOTTY || errno == EINVAL) {
+      if (!lfe->pfe_warned_pid_filter) {
+        tvhwarn(LS_PT1, "SET_PID_FILTER unsupported (errno=%d), software-only",
+                errno);
+        lfe->pfe_warned_pid_filter = 1;
+      }
+    } else {
+      tvherror(LS_PT1, "SET_PID_FILTER failed: %s", strerror(errno));
+    }
+    return;
+  }
+
+  /* Cache for next call so we can skip identical re-applies. */
+  lfe->pfe_last_n = n;
+  lfe->pfe_last_pass = 1;
+  memcpy(lfe->pfe_last_pids, pids, n * sizeof(pids[0]));
+
+  /* tvhinfo (not tvhtrace) so the application moment is visible without
+   * subsystem trace flags — lets us correlate against CC-error timestamps
+   * during investigation. The cache check above keeps this from being
+   * spammy in steady state. */
+  {
+    char pidbuf[512];
+    int off = 0;
+    pidbuf[0] = 0;
+    for (i = 0; i < n && off < (int)sizeof(pidbuf) - 8; i++)
+      off += snprintf(pidbuf + off, sizeof(pidbuf) - off,
+                      "%s%04X", i ? "," : "", pids[i]);
+    tvhinfo(LS_PT1, "pid-filter applied (%d pids) [%s]", n, pidbuf);
+  }
+}
+
+
+/* Max weight currently held on the sibling frontend. Counts both
+ * service-level subscriptions and raw mux subscriptions (mm_raw_subs,
+ * where EIT lives) — the framework's mpegts_input_get_weight only
+ * counts service subs and would report 0 for an EIT-only sibling. */
+static int
+pt1_sibling_max_weight ( pt1_frontend_t *busy_fe )
+{
+  mpegts_input_t *mi = (mpegts_input_t *)busy_fe;
+  mpegts_mux_instance_t *mmi;
+  mpegts_mux_t *mm;
+  th_subscription_t *ths;
+  service_t *s;
+  int w = 0;
+
+  tvh_mutex_lock(&mi->mi_output_lock);
+  LIST_FOREACH(mmi, &mi->mi_mux_active, mmi_active_link) {
+    mm = mmi->mmi_mux;
+    LIST_FOREACH(s, &mm->mm_transports, s_active_link)
+      LIST_FOREACH(ths, &s->s_subscriptions, ths_service_link)
+        if (ths->ths_weight > w) w = ths->ths_weight;
+    LIST_FOREACH(ths, &mm->mm_raw_subs, ths_mux_link)
+      if (ths->ths_weight > w) w = ths->ths_weight;
+  }
+  tvh_mutex_unlock(&mi->mi_output_lock);
+  return w;
+}
+
+static int
+pt1_frontend_is_enabled
+  ( mpegts_input_t *mi, mpegts_mux_t *mm, int flags, int weight )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+  pt1_adapter_t  *la  = lfe->pfe_adapter;
+  int w;
+
+  w = mpegts_input_is_enabled(mi, mm, flags, weight);
+  if (w != MI_IS_ENABLED_OK)
+    return w;
+  if (mm == NULL)
+    return MI_IS_ENABLED_OK;
+  if (lfe->pfe_in_setup)
+    return MI_IS_ENABLED_RETRY;
+
+  /* Unified chardevs (PX5, PXMLT, ISDB6014) host two frontends sharing
+   * one fd; if the sibling already holds the chardev, weight-gated
+   * preemption: if the incoming request outranks what the sibling is
+   * doing, synchronously stop the sibling's mux so the chardev frees
+   * up. linuxdvb does the weight gate; the active eviction is
+   * pt1-specific because the framework's same-input mm_stop can't
+   * reach the sibling (it's a different mpegts_input_t). */
+  if (la) {
+    pt1_frontend_t *busy_fe;
+    int busy;
+    tvh_mutex_lock(&la->pt_busy_lock);
+    busy_fe = la->pt_busy_fe;
+    busy = (busy_fe != NULL && busy_fe != lfe);
+    tvh_mutex_unlock(&la->pt_busy_lock);
+
+    if (busy) {
+      int busy_weight = pt1_sibling_max_weight(busy_fe);
+      if (weight > busy_weight) {
+        mpegts_input_t *busy_mi = (mpegts_input_t *)busy_fe;
+        mpegts_mux_instance_t *busy_mmi = LIST_FIRST(&busy_mi->mi_mux_active);
+        tvhinfo(LS_PT1, "%s - preempting sibling (weight %d > %d)",
+                busy_fe->mi_name, weight, busy_weight);
+        if (busy_mmi)
+          busy_mmi->mmi_mux->mm_stop(busy_mmi->mmi_mux, 1,
+                                     SM_CODE_SUBSCRIPTION_OVERRIDDEN);
+        tvh_mutex_lock(&la->pt_busy_lock);
+        busy = (la->pt_busy_fe != NULL && la->pt_busy_fe != lfe);
+        tvh_mutex_unlock(&la->pt_busy_lock);
+      }
+      if (busy) return MI_IS_ENABLED_RETRY;
+    }
+  }
+
+  return MI_IS_ENABLED_OK;
+}
+
+
+static pt1_frontend_t *
+pt1_frontend_create
+  ( htsmsg_t *conf, pt1_adapter_t *la, dvb_fe_type_t type )
+{
+  const idclass_t *idc;
+  const char *uuid = NULL;
+  char id[16];
+  pt1_frontend_t *lfe;
+
+  /* Internal config ID */
+  snprintf(id, sizeof(id), "Frontend %d", type);
+  if (conf)
+    conf = htsmsg_get_map(conf, id);
+  if (conf)
+    uuid = htsmsg_get_str(conf, "uuid");
+
+  /* Class */
+  idc = pt1_get_id_class_by_type(type);
+  if (idc == NULL)
+  {
+    tvherror(LS_PT1, "unknown FE type %d", type);
+    return NULL;
+  }
+
+  /* Create */
+  // Note: there is a bit of a chicken/egg issue below, without the
+  //       correct "fe_type" we cannot set the network (which is done
+  //       in mpegts_input_create()). So we must set early.
+  lfe = calloc(1, sizeof(pt1_frontend_t));
+  lfe->pfe_type = type;
+  lfe->pfe_fd = -1;
+  lfe = (pt1_frontend_t*)mpegts_input_create0((mpegts_input_t*)lfe, idc, uuid, conf);
+  if (!lfe) return NULL;
+
+  /* Default name: "<adapter-label> : <delsys> #0", mirroring linuxdvb.
+   * Replace any prior saved name so the linuxdvb-style label survives
+   * upgrades from the old "/dev/ptXvideoY" form. */
+  {
+    char namebuf[320];
+    snprintf(namebuf, sizeof(namebuf), "%s : %s #0",
+             la->pt_name ?: la->pt_rootpath,
+             dvb_type2str(type));
+    free(lfe->mi_name);
+    lfe->mi_name = strdup(namebuf);
+  }
+
+  /* Input callbacks */
+  lfe->ti_wizard_get          = pt1_frontend_wizard_get;
+  lfe->ti_wizard_set          = pt1_frontend_wizard_set;
+  lfe->mi_is_enabled          = pt1_frontend_is_enabled;
+  lfe->mi_start_mux           = pt1_frontend_start_mux;
+  lfe->mi_stop_mux            = pt1_frontend_stop_mux;
+  lfe->mi_network_list        = pt1_frontend_network_list;
+  lfe->mi_enabled_updated     = pt1_frontend_enabled_updated;
+  lfe->mi_empty_status        = mpegts_input_empty_status;
+  lfe->mi_update_pids         = pt1_input_update_pids;
+
+  /* Adapter link */
+  lfe->pfe_adapter = la;
+
+  tvh_mutex_init(&lfe->pfe_dvr_lock, NULL);
+  tvh_cond_init(&lfe->pfe_dvr_cond, 1);
+
+  /* Double check enabled */
+  pt1_frontend_enabled_updated((mpegts_input_t*)lfe);
+
+  return lfe;
+}
+
+
+static pt1_adapter_t *
+pt1_adapter_create
+  ( const char *uuid, htsmsg_t *conf,
+    const char *path )
+{
+  pt1_adapter_t *la;
+
+  /* Create */
+  la = calloc(1, sizeof(pt1_adapter_t));
+  if (!tvh_hardware_create0((tvh_hardware_t*)la, &pt1_adapter_class,
+                            uuid, conf)) {
+    /* Note: la variable is freed in tvh_hardware_create0() */
+    return NULL;
+  }
+
+  free(la->pt_rootpath);
+  la->pt_rootpath   = strdup(path);
+  {
+    char buf[256];
+    if (pt1_make_adapter_label(path, buf, sizeof(buf)) == 0)
+      la->pt_name = strdup(buf);
+    else
+      la->pt_name = strdup(path);
+  }
+  la->pt_fe[0]      = NULL;
+  la->pt_fe[1]      = NULL;
+  la->pt_busy_fe    = NULL;
+  tvh_mutex_init(&la->pt_busy_lock, NULL);
+
+  /* Callbacks */
+  //la->la_is_enabled = linuxdvb_adapter_is_enabled;
+
+  return la;
+}
+
+static pt1_adapter_t *
+pt1_adapter_new(const char *path, htsmsg_t **conf, int *save)
+{
+  pt1_adapter_t *la;
+  SHA_CTX sha1;
+  uint8_t uuidbin[20];
+  char uhex[UUID_HEX_SIZE];
+
+  /* Create hash for adapter */
+  SHA1_Init(&sha1);
+  SHA1_Update(&sha1, (void*)path,     strlen(path));
+  SHA1_Final(uuidbin, &sha1);
+
+  bin2hex(uhex, sizeof(uhex), uuidbin, sizeof(uuidbin));
+
+  /* Load config */
+  *conf = hts_settings_load("input/pt1/adapters/%s", uhex);
+  if (*conf == NULL)
+    *save = 1;
+
+  /* Create */
+  if (!(la = pt1_adapter_create(uhex, *conf, path))) {
+    htsmsg_destroy(*conf);
+    *conf = NULL;
+    return NULL;
+  }
+
+  tvhinfo(LS_PT1, "adapter added %s", path);
+  return la;
+}
+
+static void
+pt1_adapter_add ( const char *path )
+{
+  pt1_adapter_t *la = NULL;
+  htsmsg_t *conf = NULL, *feconf = NULL;
+  int save = 0;
+  const pt1_dev_info_t* dev_info = NULL;
+
+  tvhtrace(LS_PT1, "scanning adapter %s", path);
+
+  dev_info = is_pt1_dev_path(path);
+  if (dev_info == NULL) return;
+
+  /* Note: some of the below can take a while, so we relinquish the lock
+   *       to stop us blocking everyhing else
+   */
+  tvh_mutex_unlock(&global_lock);
+
+  do {
+    /* Create/Find adapter */
+    tvh_mutex_lock(&global_lock);
+    la = pt1_adapter_new(path, &conf, &save);
+    if (la == NULL) {
+      tvherror(LS_PT1, "failed to create %s", path);
+      return; // Note: save to return here as global_lock is held
+    }
+    if (conf)
+      feconf = htsmsg_get_map(conf, "frontends");
+
+    /* One frontend per cap bit; unified chardevs get both. */
+    if (dev_info->system_cap & PT1_CAP_T)
+      la->pt_fe[PT1_FE_T] = pt1_frontend_create(feconf, la, DVB_TYPE_ISDB_T);
+    if (dev_info->system_cap & PT1_CAP_S)
+      la->pt_fe[PT1_FE_S] = pt1_frontend_create(feconf, la, DVB_TYPE_ISDB_S);
+    tvh_mutex_unlock(&global_lock);
+  } while(0);
+
+  /* Cleanup */
+  if (conf)
+    htsmsg_destroy(conf);
+
+  /* Relock before exit */
+  tvh_mutex_lock(&global_lock);
+
+  /* Adapter couldn't be opened; there's nothing to work with  */
+  if (!la)
+    return;
+
+  tvhtrace(LS_PT1, "adapter created %s", path);
+
+  /* Save configuration */
+  if (save && la)
+    pt1_adapter_changed(la);
+}
+
+
+static void
+pt1_frontend_destroy ( pt1_frontend_t *lfe )
+{
+  lock_assert(&global_lock);
+
+  /* Ensure we're stopped */
+  mpegts_input_stop_all((mpegts_input_t*)lfe);
+
+  /* Stop monitor */
+  mtimer_disarm(&lfe->pfe_monitor_timer);
+
+  /* Close FDs */
+  if (lfe->pfe_fd > 0)
+    close(lfe->pfe_fd);
+
+  /* Remove from adapter, clearing whichever slot we occupied. */
+  if (lfe->pfe_adapter) {
+    pt1_adapter_t *la = lfe->pfe_adapter;
+    int slot = PT1_FE_SLOT(lfe->pfe_type);
+    if (la->pt_fe[slot] == lfe) la->pt_fe[slot] = NULL;
+    tvh_mutex_lock(&la->pt_busy_lock);
+    if (la->pt_busy_fe == lfe) la->pt_busy_fe = NULL;
+    tvh_mutex_unlock(&la->pt_busy_lock);
+  }
+
+  /* Finish */
+  mpegts_input_delete((mpegts_input_t*)lfe, 0);
+}
+
+static void
+pt1_adapter_del ( const char *path )
+{
+  pt1_adapter_t *la = NULL;
+  tvh_hardware_t *th;
+
+  LIST_FOREACH(th, &tvh_hardware, th_link)
+    if (idnode_is_instance(&th->th_id, &pt1_adapter_class)) {
+      la = (pt1_adapter_t*)th;
+      if (!strcmp(path, la->pt_rootpath))
+          break;
+    }
+  if (!th) return;
+
+  idnode_save_check(&la->th_id, 0);
+
+  if (la->pt_fe[PT1_FE_T]) pt1_frontend_destroy(la->pt_fe[PT1_FE_T]);
+  if (la->pt_fe[PT1_FE_S]) pt1_frontend_destroy(la->pt_fe[PT1_FE_S]);
+
+  tvh_mutex_destroy(&la->pt_busy_lock);
+
+  /* Free memory */
+  free(la->pt_rootpath);
+  free(la->pt_name);
+
+  /* Delete */
+  tvh_hardware_delete((tvh_hardware_t*)la);
+
+  free(la);
+}
+
+static void
+devpt1_create ( fsmonitor_t *fsm, const char *path )
+{
+  if (is_pt1_dev_path(path) == NULL) {
+    return;
+  } 
+  pt1_adapter_add(path);
+}
+
+static void
+devpt1_delete ( fsmonitor_t *fsm, const char *path )
+{
+  if (is_pt1_dev_path(path) == NULL) {
+    return;
+  }
+  tvhinfo(LS_PT1, "adapter removed %s", path);
+  pt1_adapter_del(path);
+}
+
+static fsmonitor_t devmon = {
+  .fsm_create = devpt1_create,
+  .fsm_delete = devpt1_delete
+};
+
+
+
+
+static void
+pt1_adapter_scan ( void )
+{
+  DIR *dir;
+  struct dirent buf, *de;
+  char path[1024];
+
+  if ((dir = opendir("/dev"))) {
+    while (!readdir_r(dir, &buf, &de) && de) {
+      if (de->d_name[0] == '.') continue;
+      snprintf(path, sizeof(path), "/dev/%s", de->d_name);
+      if (is_pt1_dev_path(path) == NULL) continue;
+      pt1_adapter_add(path);
+    }
+    closedir(dir);
+  }
+}
+
+
+void pt1_init ( void )
+{
+  tvhtrace(LS_PT1, "pt1_init");
+  idclass_register(&pt1_adapter_class);
+  idclass_register(&pt1_frontend_isdb_t_class);
+  idclass_register(&pt1_frontend_isdb_s_class);
+
+  (void)fsmonitor_add("/dev", &devmon);
+  pt1_adapter_scan();
+}
+
+void pt1_done ( void )
+{
+  pt1_adapter_t *la;
+  tvh_hardware_t *th, *n;
+
+  tvh_mutex_lock(&global_lock);
+  fsmonitor_del("/dev", &devmon);
+  for (th = LIST_FIRST(&tvh_hardware); th != NULL; th = n) {
+    n = LIST_NEXT(th, th_link);
+    if (idnode_is_instance(&th->th_id, &pt1_adapter_class)) {
+      la = (pt1_adapter_t*)th;
+      pt1_adapter_del(la->pt_rootpath);
+    }
+  }
+
+  tvh_mutex_unlock(&global_lock);
+
+}
