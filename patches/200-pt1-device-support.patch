+/* ************************************************************************
+ * Adapter display-name resolver (linuxdvb-style "<name> #<idx>" labels)
+ * ***********************************************************************/
+
+/*
+ * Read a small sysfs attribute file into `buf` (NUL-terminated, trailing
+ * newline stripped). Returns the byte count on success or -1 on any error.
+ */
+static int pt1_read_sysfs_attr(const char *path, char *buf, size_t buflen)
+{
+    int fd, n;
+    if (buflen == 0) return -1;
+    fd = tvh_open(path, O_RDONLY, 0);
+    if (fd < 0) return -1;
+    n = (int)read(fd, buf, buflen - 1);
+    close(fd);
+    if (n <= 0) { buf[0] = '\0'; return -1; }
+    buf[n] = '\0';
+    while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r' ||
+                     buf[n - 1] == ' '  || buf[n - 1] == '\t')) {
+        buf[--n] = '\0';
+    }
+    return n;
+}
+
+/*
+ * Static lookup of known PCI cards by (vendor, device). The list is short
+ * by design — extend as IDs are confirmed against real hardware.
+ */
+typedef struct pt1_pci_id {
+    uint16_t vendor;
+    uint16_t device;
+    const char *name;
+} pt1_pci_id_t;
+
+static const pt1_pci_id_t pt1_pci_ids[] = {
+    { 0x1172, 0x4c15, "Earthsoft PT1" },
+    { 0x10ee, 0x222a, "Earthsoft PT3" },
+    { 0, 0, NULL }
+};
+
+/*
+ * Family-name fallback: maps a chardev basename prefix to a human label.
+ * Longest prefix wins, so e.g. "pxmlt8" matches before "px".
+ */
+typedef struct pt1_family_label {
+    const char *prefix;
+    const char *label;
+} pt1_family_label_t;
+
+static const pt1_family_label_t pt1_family_labels[] = {
+    { "pxmlt8",   "PLEX PX-MLT8PE"   },
+    { "pxmlt5",   "PLEX PX-MLT5PE"   },
+    { "pxq3pe",   "PLEX PX-Q3PE"     },
+    { "pxw3u",    "PLEX PXW3U4"      },
+    { "pxs3u",    "PLEX PXS3U"       },
+    { "px4-DTV",  "PLEX PX4"         },
+    { "px4video", "PLEX PX4"         },
+    { "px5-DTV",  "PLEX PX5"         },
+    { "isdb2056", "Digibest ISDB2056"},
+    { "isdb6014", "Digibest ISDB6014"},
+    { "asv522",   "Asicen ASV5220"   },
+    { "pt1video", "Earthsoft PT1"    },
+    { "pt3video", "Earthsoft PT3"    },
+    { NULL, NULL }
+};
+
+/*
+ * Per-label sequential counter. Grows as new labels are seen at init.
+ * Process-local; rebuilt every restart in deterministic discovery order.
+ */
+typedef struct pt1_label_counter {
+    char *label;
+    int   next_idx;
+} pt1_label_counter_t;
+
+#define PT1_MAX_LABELS 64
+static pt1_label_counter_t pt1_label_counters[PT1_MAX_LABELS];
+static int pt1_label_counter_count = 0;
+
+static int pt1_next_idx_for(const char *label)
+{
+    int i;
+    for (i = 0; i < pt1_label_counter_count; i++) {
+        if (!strcmp(pt1_label_counters[i].label, label)) {
+            return pt1_label_counters[i].next_idx++;
+        }
+    }
+    if (pt1_label_counter_count >= PT1_MAX_LABELS) return 0;
+    pt1_label_counters[pt1_label_counter_count].label    = strdup(label);
+    pt1_label_counters[pt1_label_counter_count].next_idx = 1;
+    pt1_label_counter_count++;
+    return 0;
+}
+
+/*
+ * Walk parent directories of `sysdir` (an absolute /sys/... path) up to
+ * the filesystem root, applying `probe` to each. Returns whatever `probe`
+ * returns on first non-zero value, or 0 if no parent matched.
+ */
+static int pt1_sysfs_walk_up(char *sysdir,
+                             int (*probe)(const char *dir, void *aux),
+                             void *aux)
+{
+    char *p;
+    int rc;
+    while ((rc = probe(sysdir, aux)) == 0) {
+        p = strrchr(sysdir, '/');
+        if (p == NULL || p == sysdir) return 0;
+        *p = '\0';
+        if (sysdir[0] == '\0') return 0;
+    }
+    return rc;
+}
+
+/*
+ * sysfs paths are short in practice (typical depth ~10 dirs, ~150 chars).
+ * Use a fixed 1 KiB buffer so attr-path concatenation stays inside the
+ * compiler's truncation-analysis bounds without PATH_MAX over-allocation.
+ */
+#define PT1_SYSFS_PATH_MAX 1024
+
+typedef struct pt1_probe_result {
+    char  buf[256];
+    int   matched;       /* 1=USB, 2=PCI */
+} pt1_probe_result_t;
+
+static int pt1_probe_usb_or_pci(const char *dir, void *aux)
+{
+    pt1_probe_result_t *r = aux;
+    char attr[PT1_SYSFS_PATH_MAX + 32];
+    char mfr[128], prod[128], vid_s[16], did_s[16];
+
+    /* USB: manufacturer + product strings */
+    snprintf(attr, sizeof(attr), "%s/manufacturer", dir);
+    if (pt1_read_sysfs_attr(attr, mfr, sizeof(mfr)) > 0) {
+        snprintf(attr, sizeof(attr), "%s/product", dir);
+        if (pt1_read_sysfs_attr(attr, prod, sizeof(prod)) > 0) {
+            snprintf(r->buf, sizeof(r->buf), "%s %s", mfr, prod);
+            r->matched = 1;
+            return 1;
+        }
+    }
+
+    /* PCI: vendor + device IDs */
+    snprintf(attr, sizeof(attr), "%s/vendor", dir);
+    if (pt1_read_sysfs_attr(attr, vid_s, sizeof(vid_s)) > 0) {
+        snprintf(attr, sizeof(attr), "%s/device", dir);
+        if (pt1_read_sysfs_attr(attr, did_s, sizeof(did_s)) > 0) {
+            unsigned vid = (unsigned)strtoul(vid_s, NULL, 16);
+            unsigned did = (unsigned)strtoul(did_s, NULL, 16);
+            const pt1_pci_id_t *p;
+            for (p = pt1_pci_ids; p->name != NULL; p++) {
+                if (p->vendor == vid && p->device == did) {
+                    snprintf(r->buf, sizeof(r->buf), "%s", p->name);
+                    r->matched = 2;
+                    return 2;
+                }
+            }
+            /* Known PCI device but unknown ID — note it and keep walking;
+             * a higher-priority sysfs ancestor might still match a known
+             * pattern (rare, but cheap to allow). */
+            tvhinfo(LS_PT1, "unknown PCI device %04x:%04x at %s",
+                    vid, did, dir);
+        }
+    }
+
+    return 0;
+}
+
+static const char *pt1_family_label_for(const char *basename)
+{
+    const pt1_family_label_t *f;
+    for (f = pt1_family_labels; f->prefix != NULL; f++) {
+        if (!strncmp(basename, f->prefix, strlen(f->prefix))) return f->label;
+    }
+    return NULL;
+}
+
+int pt1_make_adapter_label(const char *devpath, char *out, size_t outlen)
+{
+    struct stat st;
+    char syslink[64];
+    char sysdir[PT1_SYSFS_PATH_MAX];
+    char readbuf[PT1_SYSFS_PATH_MAX];
+    const char *basename;
+    const char *label = NULL;
+    pt1_probe_result_t pr;
+    ssize_t n;
+    int idx;
+
+    if (out == NULL || outlen == 0) return -1;
+    out[0] = '\0';
+
+    basename = strrchr(devpath, '/');
+    basename = basename ? basename + 1 : devpath;
+
+    /* Tier 1/2: sysfs walk from the chardev to its USB / PCI parent. */
+    memset(&pr, 0, sizeof(pr));
+    if (stat(devpath, &st) == 0 && S_ISCHR(st.st_mode)) {
+        snprintf(syslink, sizeof(syslink), "/sys/dev/char/%u:%u",
+                 (unsigned)major(st.st_rdev), (unsigned)minor(st.st_rdev));
+        n = readlink(syslink, readbuf, sizeof(readbuf) - 1);
+        if (n > 0) {
+            readbuf[n] = '\0';
+            /*
+             * readlink may return a relative path like "../../devices/...";
+             * pass it to realpath(NULL) so glibc allocates a PATH_MAX-sized
+             * buffer itself — handing realpath() a stack buffer < PATH_MAX
+             * is a stack-overrun bug (signal 6 / abort on -D_FORTIFY_SOURCE).
+             */
+            char abs[PT1_SYSFS_PATH_MAX];
+            int absn = snprintf(abs, sizeof(abs), "/sys/dev/char/%s", readbuf);
+            if (absn > 0 && absn < (int)sizeof(abs)) {
+                char *resolved = realpath(abs, NULL);
+                if (resolved != NULL) {
+                    if (strlen(resolved) < sizeof(sysdir)) {
+                        strcpy(sysdir, resolved);
+                        if (pt1_sysfs_walk_up(sysdir,
+                                              pt1_probe_usb_or_pci, &pr) > 0)
+                            label = pr.buf;
+                    }
+                    free(resolved);
+                }
+            }
+        }
+    }
+
+    /* Tier 3: family-name fallback by chardev basename. */
+    if (label == NULL) label = pt1_family_label_for(basename);
+
+    /* Tier 4: basename verbatim. */
+    if (label == NULL) {
+        tvhinfo(LS_PT1, "unknown sysfs lineage for %s, falling back to basename",
+                devpath);
+        label = basename;
+    }
+
+    idx = pt1_next_idx_for(label);
+    if (snprintf(out, outlen, "%s #%d", label, idx) >= (int)outlen) {
+        out[0] = '\0';
+        return -1;
+    }
+    return 0;
+}
+
+/* ************************************************************************
+ * Raw CN value → millibel (dB * 1000) conversion
+ * ***********************************************************************/
+
+/*
+ * cxd2856er internal CN encoding tables, transplanted from px4_drv's
+ * pxmlt_device.c (`isdbt_cn_raw_table[]` and `isdbs_cn_raw_table[]`). The
+ * kernel binary-searches its raw register reading against the .val column
+ * and hands us the matching .cn value via the PTX_GET_CNR ioctl — so we
+ * carry just the .cn column here and reverse-binary-search it back to a
+ * table index, then translate the index to dB.
+ *
+ *   ISDB-T : 49 entries, index 0 = 34.0 dB, step = -0.5 dB/index
+ *   ISDB-S : 192 entries, index 0 =  0.0 dB (no-lock), step = +0.1 dB/index
+ *
+ * Both columns are monotonic decreasing.
+ */
+static const uint32_t pt1_isdbt_cn_table[] = {
+    0xb19ff,0x9eecd,0x8cd8b,0x7c302,0x6f132,0x6250d,0x57a1c,0x4db45,0x45725,
+    0x3da59,0x36f9d,0x30e58,0x2b76e,0x26abb,0x22794,0x1eac7,0x1b4a8,0x1844d,
+    0x159a2,0x13365,0x11196,0xf3ae,0xd8cb,0xc0fd,0xabf9,0x9923,0x8868,0x7995,
+    0x6c78,0x60cf,0x5675,0x4d43,0x4520,0x3de4,0x377b,0x31cc,0x2cbf,0x2843,
+    0x2447,0x20bb,0x1d95,0x1ac6,0x1846,0x160a,0x140c,0x1243,0x10ab,0xf3c,
+    0xdf3
+};
+
+static const uint32_t pt1_isdbs_cn_table[] = {
+    0x9546,0x94d9,0x946b,0x93fc,0x938c,0x931b,0x92a8,0x9235,0x91c1,0x914b,
+    0x90d5,0x905d,0x8fe4,0x8f6a,0x8eef,0x8e72,0x8df5,0x8d76,0x8cf5,0x8c74,
+    0x8bf1,0x8b6c,0x8ae7,0x8a60,0x89d7,0x894d,0x88c2,0x8835,0x87a6,0x8716,
+    0x8685,0x85f1,0x855d,0x84c6,0x842e,0x8394,0x82f9,0x825b,0x81bc,0x811c,
+    0x8079,0x7fd5,0x7f2f,0x7e87,0x7ddd,0x7d31,0x7c83,0x7bd4,0x7b22,0x7a6f,
+    0x79ba,0x7903,0x784a,0x778f,0x76d3,0x7614,0x7554,0x7492,0x73ce,0x7308,
+    0x7241,0x7178,0x70ad,0x6fe1,0x6f13,0x6e44,0x6d74,0x6ca2,0x6bcf,0x6afb,
+    0x6a26,0x6950,0x687a,0x67a2,0x66ca,0x65f1,0x6517,0x643e,0x6364,0x628a,
+    0x61b0,0x60d6,0x5ffc,0x5f22,0x5e49,0x5d70,0x5c98,0x5bc0,0x5ae9,0x5a13,
+    0x593e,0x5869,0x5796,0x56c4,0x55f3,0x5523,0x5454,0x5387,0x52bb,0x51f0,
+    0x5126,0x505e,0x4f98,0x4ed3,0x4e0f,0x4d4d,0x4c8d,0x4bce,0x4b10,0x4a55,
+    0x499a,0x48e1,0x482a,0x4774,0x46c0,0x460d,0x455c,0x44ac,0x43fe,0x4352,
+    0x42a6,0x41fd,0x4154,0x40ae,0x4008,0x3f64,0x3ec2,0x3e21,0x3d81,0x3ce3,
+    0x3c46,0x3baa,0x3b10,0x3a77,0x39e0,0x394a,0x38b5,0x3821,0x378f,0x36fe,
+    0x366e,0x35e0,0x3553,0x34c7,0x343c,0x33b3,0x332b,0x32a4,0x321e,0x319a,
+    0x3116,0x3094,0x3014,0x2f94,0x2f16,0x2e99,0x2e1d,0x2da2,0x2d29,0x2cb0,
+    0x2c39,0x2bc4,0x2b4f,0x2adc,0x2a6a,0x29f9,0x2989,0x291a,0x28ad,0x2841,
+    0x27d6,0x276d,0x2705,0x269e,0x2638,0x25d3,0x2570,0x24ad,0x244d,0x23ef,
+    0x2336,0x22db,0x222a,0x217d,0x20d5,0x2083,0x1fe3,0x1f94,0x1efb,0x1e66,
+    0x1dd6,0x1d90
+};
+
+/*
+ * Reverse-lookup `raw` in a monotonic-decreasing table; return the index
+ * of the entry whose value is closest. Clamps to the endpoints.
+ */
+static int pt1_table_index_for_cn(const uint32_t *table, int n, uint32_t raw)
+{
+    int lo = 0, hi = n - 1;
+    if (raw >= table[0])     return 0;
+    if (raw <= table[hi])    return hi;
+    while (lo < hi - 1) {
+        int mid = lo + (hi - lo) / 2;
+        if (table[mid] == raw) return mid;
+        if (table[mid] > raw)  lo = mid;
+        else                   hi = mid;
+    }
+    /* table[lo] >= raw >= table[hi]; pick the closer of the two */
+    return (table[lo] - raw) <= (raw - table[hi]) ? lo : hi;
+}
+
+static int pt1_path_is_old_earthsoft(const char *path)
+{
+    const char *base = strrchr(path, '/');
+    base = base ? base + 1 : path;
+    return !strncmp(base, "pt1video", 8) || !strncmp(base, "pt3video", 8);
+}
+
+int pt1_cn_to_millibel(const char *path, dvb_fe_type_t type, uint32_t raw)
+{
+    /*
+     * Old Earthsoft PT1/PT2/PT3 chip: GET_SIGNAL_STRENGTH returns a 24-bit
+     * raw register value. Apply the recpt1 polynomial.
+     */
+    if (pt1_path_is_old_earthsoft(path)) {
+        if (raw == 0) return INT_MIN;   /* divide-by-zero guard */
+        if (type == DVB_TYPE_ISDB_T) {
+            double P = log10(5505024.0 / (double)raw) * 10.0;
+            double CNR = (0.000024 * P * P * P * P) - (0.0016 * P * P * P) +
+                         (0.0398 * P * P) + (0.5491 * P) + 3.0965;
+            return (int)(CNR * 1000.0);
+        }
+        /* ISDB-S on the old chip: recpt1's linear-interpolation lookup.
+         * The kernel returns the value as-is (raw register, not pre-converted),
+         * so we replicate recpt1::getsignal_isdb_s. */
+        static const float lut[] = {
+            24.07f, 24.07f, 18.61f, 15.21f, 12.50f, 10.19f, 8.140f,
+             6.270f, 4.550f, 3.730f, 3.630f, 2.940f, 1.420f, 0.000f
+        };
+        unsigned char b0 = (raw >> 8) & 0xff;
+        unsigned char b1 = raw & 0xff;
+        float cnr;
+        if (b0 <= 0x10) cnr = 24.07f;
+        else if (b0 >= 0xb0) cnr = 0.0f;
+        else {
+            float mix = (float)(((b0 & 0x0f) << 8) | b0) / 4096.0f;
+            cnr = lut[b0 >> 4] * (1.0f - mix) + lut[(b0 >> 4) + 1] * mix;
+        }
+        (void)b1;
+        return (int)(cnr * 1000.0f);
+    }
+
+    /*
+     * px4_drv (cxd2856er) chardev: PTX_GET_CNR returns a table-encoded `cn`
+     * already, not a raw register. Reverse-binary-search our copy of the
+     * kernel's table to recover the dB.
+     */
+    if (type == DVB_TYPE_ISDB_T) {
+        int i = pt1_table_index_for_cn(pt1_isdbt_cn_table,
+                                       (int)(sizeof(pt1_isdbt_cn_table) /
+                                             sizeof(*pt1_isdbt_cn_table)), raw);
+        /* index 0 = 34.0 dB, step -0.5 dB per index */
+        return 34000 - i * 500;
+    } else {
+        int i = pt1_table_index_for_cn(pt1_isdbs_cn_table,
+                                       (int)(sizeof(pt1_isdbs_cn_table) /
+                                             sizeof(*pt1_isdbs_cn_table)), raw);
+        /* index 0 = 0.0 dB (no-lock), step +0.1 dB per index */
+        return 0 + i * 100;
+    }
+}
Index: src/src/input/mpegts/pt1/pt1_dev.h
