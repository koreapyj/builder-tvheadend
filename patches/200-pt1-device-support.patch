+static void
+pt1_frontend_monitor ( void *aux )
+{
+  char buf[256];
+  pt1_frontend_t *lfe = aux;
+  mpegts_mux_instance_t *mmi = LIST_FIRST(&lfe->mi_mux_active);
+  mpegts_mux_t *mm;
+  signal_status_t sigstat;
+  streaming_message_t sm;
+  service_t *s;
+  int e;
+  uint32_t period = MINMAX(lfe->pfe_status_period, 250, 8000);
+  signal_status_scale_t snr_scale = SIGNAL_STATUS_SCALE_UNKNOWN;
+  int snr = 0;
+  int dvr = -1;
+
+  lfe->mi_display_name((mpegts_input_t*)lfe, buf, sizeof(buf));
+  tvhtrace(LS_PT1, "%s - checking FE status %d/%d/%d error:%d", buf, lfe->mi_enabled, lfe->pfe_ready, lfe->pfe_locked, lfe->pfe_dvr_error);
+  
+  /* Disabled */
+  if (!lfe->mi_enabled && mmi)
+    mmi->mmi_mux->mm_stop(mmi->mmi_mux, 1, SM_CODE_ABORTED);
+  //else if(lfe->pfe_dvr_error && mmi)
+  //  mmi->mmi_mux->mm_stop(mmi->mmi_mux, 1, lfe->pfe_dvr_error);
+
+  /* Stop timer */
+  if (!mmi || !lfe->pfe_ready) return;
+
+  /* re-arm */
+  mtimer_arm_rel(&lfe->pfe_monitor_timer, pt1_frontend_monitor, lfe, ms2mono(period));
+
+  /* Get current mux */
+  mm = mmi->mmi_mux;
+
+  /* Waiting for lock */
+  if (!lfe->pfe_locked) {
+    lfe->pfe_locked = 1;
+
+    tvh_mutex_lock(&lfe->pfe_dvr_lock);
+    if (lfe->pfe_thread_started == 0)
+    {
+      lfe->pfe_dvr_error = 0;
+      lfe->pfe_thread_started = 1;
+      lfe->pfe_thread_running = 1;
+      tvh_thread_create(&lfe->pfe_dvr_thread, NULL,
+                        pt1_frontend_input_thread, lfe, "lnxdvb-front");
+      do {
+        e = tvh_cond_wait(&lfe->pfe_dvr_cond, &lfe->pfe_dvr_lock);
+        if (e == ETIMEDOUT)
+          break;
+      } while (ERRNO_AGAIN(e));
+    }
+    else
+    {
+      tvherror(LS_PT1, "pfe_thread_started already?");
+    }
+    tvh_mutex_unlock(&lfe->pfe_dvr_lock);
+
+    /* Table handlers */
+    psi_tables_install((mpegts_input_t *)lfe, mm,
+                        ((dvb_mux_t *)mm)->lm_tuning.dmc_fe_delsys);
+  } else {
+    if (mclk() < lfe->pfe_monitor)
+      return;
+    lfe->pfe_monitor = mclk() + ms2mono(period);
+  }
+
+  dvr = lfe->pfe_fd;
+  if (dvr > 0 && !lfe->pfe_dvr_error) {
+    if (ioctl(dvr, GET_SIGNAL_STRENGTH, &snr) != 0) {
+      tvherror(LS_PT1, "%s - GET_SIGNAL_STRENGTH failed [e=%s]", buf, strerror(errno));
+    } else if (lfe->pfe_type == DVB_TYPE_ISDB_S) {
+      // TODO
+      snr_scale = SIGNAL_STATUS_SCALE_DECIBEL;
+    } else {
+      snr_scale = SIGNAL_STATUS_SCALE_DECIBEL;
+      double P = log10(5505024/(double)snr) * 10;
+      double CNR = (0.000024 * P * P * P * P) - (0.0016 * P * P * P) +
+                    (0.0398 * P * P) + (0.5491 * P)+3.0965;
+      snr = CNR * 1000;
+    }
+  }
+
+
+  tvh_mutex_lock(&mmi->tii_stats_mutex);
+  mmi->tii_stats.signal_scale = SIGNAL_STATUS_SCALE_UNKNOWN;
+  mmi->tii_stats.signal = 0;
+  mmi->tii_stats.ec_bit = 0;
+  mmi->tii_stats.tc_bit = 0;
+  mmi->tii_stats.snr_scale = snr_scale;
+  mmi->tii_stats.snr = snr;
+  mmi->tii_stats.tc_block = 0;
+
+  /* Send message */
+  sigstat.status_text  = "UNKNOWN";
+  sigstat.snr          = mmi->tii_stats.snr;
+  sigstat.signal       = mmi->tii_stats.signal;
+  sigstat.ber          = mmi->tii_stats.ber;
+  sigstat.unc          = atomic_get(&mmi->tii_stats.unc);
+  sigstat.signal_scale = mmi->tii_stats.signal_scale;
+  sigstat.snr_scale    = mmi->tii_stats.snr_scale;
+  sigstat.ec_bit       = mmi->tii_stats.ec_bit;
+  sigstat.tc_bit       = mmi->tii_stats.tc_bit;
+  sigstat.ec_block     = mmi->tii_stats.ec_block;
+  sigstat.tc_block     = mmi->tii_stats.tc_block;
+  memset(&sm, 0, sizeof(sm));
+  sm.sm_type = SMT_SIGNAL_STATUS;
+  sm.sm_data = &sigstat;
+
+  tvh_mutex_unlock(&mmi->tii_stats_mutex);
+
+  LIST_FOREACH(s, &mmi->mmi_mux->mm_transports, s_active_link) {
+    tvh_mutex_lock(&s->s_stream_mutex);
+    streaming_service_deliver(s, streaming_msg_clone(&sm));
+    tvh_mutex_unlock(&s->s_stream_mutex);
+  }
+}
+
+
+static int
+pt1_frontend_start_mux
+  ( mpegts_input_t *mi, mpegts_mux_instance_t *mmi, int weight )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+  char buf1[256];
+
+  lfe->mi_display_name((mpegts_input_t*)lfe, buf1, sizeof(buf1));
+  {
+    dvb_mux_t *dm = (dvb_mux_t*)mmi->mmi_mux;
+    FREQUENCY probe;
+    if (pt1_resolve_freq(dm->lm_tuning.dmc_fe_freq,
+                         dm->lm_tuning.dmc_fe_stream_id,
+                         lfe->pfe_type, &probe) != 0) {
+      tvherror(LS_PT1, "%s - invalid freq: %s", buf1, mmi->mmi_mux->mm_nicename);
+      return SM_CODE_TUNING_FAILED;
+    }
+  }
+
+  tvhdebug(LS_PT1, "%s - starting %s", buf1, mmi->mmi_mux->mm_nicename);
+
+  lfe->pfe_ready = 1;
+  lfe->pfe_in_setup = 1;
+  lfe->pfe_monitor = mclk() + sec2mono(4);
+  mtimer_arm_rel(&lfe->pfe_monitor_timer, pt1_frontend_monitor, lfe, ms2mono(50));
+  return 0;
+}
+
+
+static void
+pt1_frontend_stop_mux
+  ( mpegts_input_t *mi, mpegts_mux_instance_t *mmi )
+{
+  char buf1[256];
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+
+  mi->mi_display_name(mi, buf1, sizeof(buf1));
+  tvhdebug(LS_PT1, "%s - stopping %s", buf1, mmi->mmi_mux->mm_nicename);
+
+  /* Stop thread */
+  if (lfe->pfe_thread_started) {
+    lfe->pfe_thread_running = 0;
+    tvhtrace(LS_PT1, "%s - waiting for dvr thread", buf1);
+    pthread_join(lfe->pfe_dvr_thread, NULL);
+    lfe->pfe_thread_started = 0;
+    tvhdebug(LS_PT1, "%s - stopped dvr thread", buf1);
+  }
+
+  lfe->pfe_dvr_error = 0;
+  lfe->pfe_locked = 0;
+  lfe->pfe_ready = 0;
+  lfe->pfe_in_setup = 0;
+
+  mtimer_arm_rel(&lfe->pfe_monitor_timer, pt1_frontend_monitor, lfe, sec2mono(2));
+}
+
+
+static int
+pt1_frontend_is_enabled
+  ( mpegts_input_t *mi, mpegts_mux_t *mm, int flags, int weight )
+{
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+  int w;
+
+  w = mpegts_input_is_enabled(mi, mm, flags, weight);
+  if (w != MI_IS_ENABLED_OK)
+    return w;
+  if (mm == NULL)
+    return MI_IS_ENABLED_OK;
+  if (lfe->pfe_in_setup)
+    return MI_IS_ENABLED_RETRY;
+
+  return MI_IS_ENABLED_OK;
+}
+
+
+static pt1_frontend_t *
+pt1_frontend_create
+  ( htsmsg_t *conf, pt1_adapter_t *la, dvb_fe_type_t type )
+{
+  const idclass_t *idc;
+  const char *uuid = NULL;
+  char id[16];
+  pt1_frontend_t *lfe;
+
+  /* Internal config ID */
+  snprintf(id, sizeof(id), "Frontend %d", type);
+  if (conf)
+    conf = htsmsg_get_map(conf, id);
+  if (conf)
+    uuid = htsmsg_get_str(conf, "uuid");
+
+  /* Class */
+  idc = pt1_get_id_class_by_type(type);
+  if (idc == NULL)
+  {
+    tvherror(LS_PT1, "unknown FE type %d", type);
+    return NULL;
+  }
+
+  /* Create */
+  // Note: there is a bit of a chicken/egg issue below, without the
+  //       correct "fe_type" we cannot set the network (which is done
+  //       in mpegts_input_create()). So we must set early.
+  lfe = calloc(1, sizeof(pt1_frontend_t));
+  lfe->pfe_type = type;
+  lfe->pfe_fd = -1;
+  lfe = (pt1_frontend_t*)mpegts_input_create0((mpegts_input_t*)lfe, idc, uuid, conf);
+  if (!lfe) return NULL;
+
+  /* Default name */
+  if (!lfe->mi_name) {
+    lfe->mi_name = strdup(la->pt_rootpath);
+  }
+
+  /* Input callbacks */
+  lfe->ti_wizard_get          = pt1_frontend_wizard_get;
+  lfe->ti_wizard_set          = pt1_frontend_wizard_set;
+  lfe->mi_is_enabled          = pt1_frontend_is_enabled;
+  lfe->mi_start_mux           = pt1_frontend_start_mux;
+  lfe->mi_stop_mux            = pt1_frontend_stop_mux;
+  lfe->mi_network_list        = pt1_frontend_network_list;
+  lfe->mi_enabled_updated     = pt1_frontend_enabled_updated;
+  lfe->mi_empty_status        = mpegts_input_empty_status;
+
+  /* Adapter link */
+  lfe->pfe_adapter = la;
+
+  tvh_mutex_init(&lfe->pfe_dvr_lock, NULL);
+  tvh_cond_init(&lfe->pfe_dvr_cond, 1);
+
+  /* Double check enabled */
+  pt1_frontend_enabled_updated((mpegts_input_t*)lfe);
+
+  return lfe;
+}
+
+
+static pt1_adapter_t *
+pt1_adapter_create
+  ( const char *uuid, htsmsg_t *conf,
+    const char *path )
+{
+  pt1_adapter_t *la;
+
+  /* Create */
+  la = calloc(1, sizeof(pt1_adapter_t));
+  if (!tvh_hardware_create0((tvh_hardware_t*)la, &pt1_adapter_class,
+                            uuid, conf)) {
+    /* Note: la variable is freed in tvh_hardware_create0() */
+    return NULL;
+  }
+
+  free(la->pt_rootpath);
+  la->pt_rootpath   = strdup(path);
+  la->pt_name       = strdup(path);
+  la->pt_frontend   = NULL;
+
+  /* Callbacks */
+  //la->la_is_enabled = linuxdvb_adapter_is_enabled;
+
+  return la;
+}
+
+static pt1_adapter_t *
+pt1_adapter_new(const char *path, htsmsg_t **conf, int *save)
+{
+  pt1_adapter_t *la;
+  SHA_CTX sha1;
+  uint8_t uuidbin[20];
+  char uhex[UUID_HEX_SIZE];
+
+  /* Create hash for adapter */
+  SHA1_Init(&sha1);
+  SHA1_Update(&sha1, (void*)path,     strlen(path));
+  SHA1_Final(uuidbin, &sha1);
+
+  bin2hex(uhex, sizeof(uhex), uuidbin, sizeof(uuidbin));
+
+  /* Load config */
+  *conf = hts_settings_load("input/pt1/adapters/%s", uhex);
+  if (*conf == NULL)
+    *save = 1;
+
+  /* Create */
+  if (!(la = pt1_adapter_create(uhex, *conf, path))) {
+    htsmsg_destroy(*conf);
+    *conf = NULL;
+    return NULL;
+  }
+
+  tvhinfo(LS_PT1, "adapter added %s", path);
+  return la;
+}
+
+static void
+pt1_adapter_add ( const char *path )
+{
+  pt1_adapter_t *la = NULL;
+  htsmsg_t *conf = NULL, *feconf = NULL;
+  int save = 0;
+  const pt1_dev_info_t* dev_info = NULL;
+
+  tvhtrace(LS_PT1, "scanning adapter %s", path);
+
+  dev_info = is_pt1_dev_path(path);
+  if (dev_info == NULL) return;
+
+  /* Note: some of the below can take a while, so we relinquish the lock
+   *       to stop us blocking everyhing else
+   */
+  tvh_mutex_unlock(&global_lock);
+
+  do {
+    /* Create/Find adapter */
+    tvh_mutex_lock(&global_lock);
+    la = pt1_adapter_new(path, &conf, &save);
+    if (la == NULL) {
+      tvherror(LS_PT1, "failed to create %s", path);
+      return; // Note: save to return here as global_lock is held
+    }
+    if (conf)
+      feconf = htsmsg_get_map(conf, "frontends");
+
+    la->pt_frontend = pt1_frontend_create(feconf, la, dev_info->type);
+    tvh_mutex_unlock(&global_lock);
+  } while(0);
+
+  /* Cleanup */
+  if (conf)
+    htsmsg_destroy(conf);
+
+  /* Relock before exit */
+  tvh_mutex_lock(&global_lock);
+
+  /* Adapter couldn't be opened; there's nothing to work with  */
+  if (!la)
+    return;
+
+  tvhtrace(LS_PT1, "adapter created %s", path);
+
+  /* Save configuration */
+  if (save && la)
+    pt1_adapter_changed(la);
+}
+
+
+static void
+pt1_frontend_destroy ( pt1_frontend_t *lfe )
+{
+  lock_assert(&global_lock);
+
+  /* Ensure we're stopped */
+  mpegts_input_stop_all((mpegts_input_t*)lfe);
+
+  /* Stop monitor */
+  mtimer_disarm(&lfe->pfe_monitor_timer);
+
+  /* Close FDs */
+  if (lfe->pfe_fd > 0)
+    close(lfe->pfe_fd);
+
+  /* Remove from adapter */
+  if (lfe->pfe_adapter) lfe->pfe_adapter->pt_frontend = NULL;
+
+  /* Finish */
+  mpegts_input_delete((mpegts_input_t*)lfe, 0);
+}
+
+static void
+pt1_adapter_del ( const char *path )
+{
+  pt1_adapter_t *la = NULL;
+  tvh_hardware_t *th;
+
+  LIST_FOREACH(th, &tvh_hardware, th_link)
+    if (idnode_is_instance(&th->th_id, &pt1_adapter_class)) {
+      la = (pt1_adapter_t*)th;
+      if (!strcmp(path, la->pt_rootpath))
+          break;
+    }
+  if (!th) return;
+
+  idnode_save_check(&la->th_id, 0);
+
+  if (la->pt_frontend) pt1_frontend_destroy(la->pt_frontend);
+
+  /* Free memory */
+  free(la->pt_rootpath);
+  free(la->pt_name);
+    
+  /* Delete */
+  tvh_hardware_delete((tvh_hardware_t*)la);
+
+  free(la);
+}
+
+static void
+devpt1_create ( fsmonitor_t *fsm, const char *path )
+{
+  if (is_pt1_dev_path(path) == NULL) {
+    return;
+  } 
+  pt1_adapter_add(path);
+}
+
+static void
+devpt1_delete ( fsmonitor_t *fsm, const char *path )
+{
+  if (is_pt1_dev_path(path) == NULL) {
+    return;
+  }
+  tvhinfo(LS_PT1, "adapter removed %s", path);
+  pt1_adapter_del(path);
+}
+
+static fsmonitor_t devmon = {
+  .fsm_create = devpt1_create,
+  .fsm_delete = devpt1_delete
+};
+
+
+
+
+static void
+pt1_adapter_scan ( void )
+{
+  DIR *dir;
+  struct dirent buf, *de;
+  char path[1024];
+
+  if ((dir = opendir("/dev"))) {
+    while (!readdir_r(dir, &buf, &de) && de) {
+      if (de->d_name[0] == '.') continue;
+      snprintf(path, sizeof(path), "/dev/%s", de->d_name);
+      if (is_pt1_dev_path(path) == NULL) continue;
+      pt1_adapter_add(path);
+    }
+    closedir(dir);
+  }
+}
+
+
+void pt1_init ( void )
+{
+  tvhtrace(LS_PT1, "pt1_init");
+  idclass_register(&pt1_adapter_class);
+  idclass_register(&pt1_frontend_isdb_t_class);
+  idclass_register(&pt1_frontend_isdb_s_class);
+
+  (void)fsmonitor_add("/dev", &devmon);
+  pt1_adapter_scan();
+}
+
+void pt1_done ( void )
+{
+  pt1_adapter_t *la;
+  tvh_hardware_t *th, *n;
+
+  tvh_mutex_lock(&global_lock);
+  fsmonitor_del("/dev", &devmon);
+  for (th = LIST_FIRST(&tvh_hardware); th != NULL; th = n) {
+    n = LIST_NEXT(th, th_link);
+    if (idnode_is_instance(&th->th_id, &pt1_adapter_class)) {
+      la = (pt1_adapter_t*)th;
+      pt1_adapter_del(la->pt_rootpath);
+    }
+  }
+
+  tvh_mutex_unlock(&global_lock);
+
+}
