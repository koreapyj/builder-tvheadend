+static const idclass_t*
+pt1_get_id_class_by_type(dvb_fe_type_t type)
+{
+    if (type == DVB_TYPE_ISDB_T)
+        return &pt1_frontend_isdb_t_class;
+    else if (type == DVB_TYPE_ISDB_S)
+        return &pt1_frontend_isdb_s_class;
+    else
+        return NULL;
+}
