+static void
+pt1_frontend_close_fd ( pt1_frontend_t *lfe, const char *name )
+{
+  char buf[256];
+  int fd = atomic_exchange(&lfe->pfe_fd, -1);
+  if (fd <= 0)
+    return;
+
+  if (name == NULL) {
+    lfe->mi_display_name((mpegts_input_t *)lfe, buf, sizeof(buf));
+    name = buf;
+  }
+
+  tvhtrace(LS_PT1, "%s - closing FE %s",
+           name, lfe->pfe_adapter->pt_rootpath);
+  close(fd);
+
+  /* Release the chardev so the sibling frontend (if any) can tune. */
+  if (lfe->pfe_adapter) {
+    pt1_adapter_t *la = lfe->pfe_adapter;
+    tvh_mutex_lock(&la->pt_busy_lock);
+    if (la->pt_busy_fe == lfe) la->pt_busy_fe = NULL;
+    tvh_mutex_unlock(&la->pt_busy_lock);
+  }
+}
+
+static int
+pt1_frontend_open_fd ( pt1_frontend_t *lfe, const char *name )
+{
+  if (lfe->pfe_fd > 0)
+    return lfe->pfe_fd;
+
+  int fd = tvh_open(lfe->pfe_adapter->pt_rootpath, O_RDONLY/* | O_NONBLOCK*/, 0);
+  if (fd <= 0)
+    return fd;
+
+  int oldfd = atomic_exchange(&lfe->pfe_fd, fd);
+  if (oldfd > 0)
+    close(oldfd);
+
+  /* Fresh fd -- reset one-shot pid-filter warning so a degraded path
+   * still gets logged once per tune. Also clear the cached PID set
+   * since the driver's release path restored the device-default
+   * filter when the previous fd closed. */
+  lfe->pfe_warned_pid_filter = 0;
+  lfe->pfe_last_n = -1;
+  lfe->pfe_last_pass = 0;
+
+  tvhtrace(LS_PT1, "%s - opening FE %s (%d)",
+           name, lfe->pfe_adapter->pt_rootpath, fd);
+
+  /* Claim the chardev — sibling frontend (if any) will report
+   * MI_IS_ENABLED_RETRY in mi_is_enabled until we close. */
+  if (lfe->pfe_adapter) {
+    pt1_adapter_t *la = lfe->pfe_adapter;
+    tvh_mutex_lock(&la->pt_busy_lock);
+    la->pt_busy_fe = lfe;
+    tvh_mutex_unlock(&la->pt_busy_lock);
+  }
+
+  return lfe->pfe_fd;
+}
+
+
+static void
+pt1_frontend_enabled_updated ( mpegts_input_t *mi )
+{
+  char buf[512];
+  pt1_frontend_t *lfe = (pt1_frontend_t*)mi;
+
+  mi->mi_display_name(mi, buf, sizeof(buf));
+
+  /* Ensure disabled */
+  if (!mi->mi_enabled) {
+    tvhtrace(LS_PT1, "%s - disabling tuner", buf);
+    pt1_frontend_close_fd(lfe, buf);
+    mtimer_disarm(&lfe->pfe_monitor_timer);
+
+  /* Ensure FE opened (if not powersave) */
+  }
+}
