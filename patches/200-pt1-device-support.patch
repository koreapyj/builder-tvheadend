+/*
+ * Resolve a mux into the kernel ioctl arg for SET_CHANNEL.
+ *
+ *   ISDB-T : freq is the UHF/VHF centre frequency in Hz.
+ *            stream_id is ignored. out->slot is set to 0.
+ *   ISDB-S : freq is the PHYSICAL satellite downlink frequency in kHz
+ *            (e.g. 11727480 for BS-1). The Japanese BS LO of 10.678 GHz
+ *            is subtracted internally; tvheadend's network-level LNB
+ *            selector is NOT consulted (Japanese BS/CS is single-band and
+ *            does not fit tvheadend's Universal-LNB defaults).
+ *            stream_id supplies out->slot (the ARIB TSID the kernel uses
+ *            to pick a stream on the transponder).
+ *
+ * Returns 0 on success and fills *out, or -1 if the frequency falls outside
+ * any supported segment (with ±100 kHz tolerance).
+ */
+int pt1_resolve_freq(uint32_t freq, int stream_id,
+                     dvb_fe_type_t type, FREQUENCY *out);
+
+#endif
