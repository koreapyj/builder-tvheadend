+/*
+ * ISDB-T: derive the kernel driver's `frequencyno` from the mux frequency
+ * (Hz). The kernel's internal table is contiguous within three segments of
+ * 6 MHz spacing, with two 8 MHz jumps at the historical analog-TV channel
+ * boundaries (sub-VHF / VHF-high / UHF13-up). There is no single formula
+ * across the whole UHF/VHF range; instead we describe each segment
+ * explicitly so a single linear formula applies inside it.
+ */
+typedef struct pt1_isdbt_segment {
+    uint32_t lo_hz;     /* lowest centre frequency in this segment */
+    uint32_t hi_hz;     /* highest centre frequency in this segment */
+    int      base_no;   /* kernel frequencyno that corresponds to lo_hz */
+} pt1_isdbt_segment_t;
+
+#define PT1_ISDBT_STEP_HZ        6000000u   /* 6 MHz channel raster */
+#define PT1_ISDBT_TOLERANCE_HZ    100000u   /* ±100 kHz of the grid */
+
+static const pt1_isdbt_segment_t isdbt_segments[] = {
+    { 111143000u, 159143000u,  3 },  /* sub-VHF block, freqno  3.. 11 */
+    { 167143000u, 167143000u, 12 },  /*     singleton, freqno 12      */
+    { 225143000u, 465143000u, 22 },  /* VHF-high block, freqno 22.. 62 */
+    { 473143000u, 473143000u, 63 },  /* UHF13 singleton, freqno 63    */
+    { 479143000u, 767143000u, 64 },  /* UHF14..62 block, freqno 64..112 */
+};
+
+/*
+ * ISDB-S: derive `frequencyno` (transponder index, 0..23) from the PHYSICAL
+ * satellite downlink frequency in kHz. We subtract the Japanese BS standard
+ * LO (10.678 GHz) internally and split the range into the BS plane
+ * (38.36 MHz spacing) and the CS plane (40 MHz spacing). tvheadend's
+ * network-level LNB selector is intentionally ignored.
+ *
+ *   BS  freqno  0..11 : IF 1 049 480..1 471 440 kHz  (= 11.727 480..12.149 440 GHz)
+ *   CS  freqno 12..23 : IF 1 613 000..2 053 000 kHz  (= 12.291 000..12.731 000 GHz)
+ */
+#define PT1_ISDBS_LO_KHZ           10678000u
+#define PT1_ISDBS_BS_LO_IF_KHZ      1049480u
+#define PT1_ISDBS_BS_HI_IF_KHZ      1471440u
+#define PT1_ISDBS_BS_STEP_KHZ         38360u
+#define PT1_ISDBS_CS_LO_IF_KHZ      1613000u
+#define PT1_ISDBS_CS_HI_IF_KHZ      2053000u
+#define PT1_ISDBS_CS_STEP_KHZ         40000u
+#define PT1_ISDBS_CS_BASE_NO             12
+#define PT1_ISDBS_TOLERANCE_KHZ          100   /* ±100 kHz of the grid */
+
+static int pt1_resolve_isdbt(uint32_t freq_hz, FREQUENCY *out)
+{
+    size_t i;
+    for (i = 0; i < sizeof(isdbt_segments) / sizeof(*isdbt_segments); i++) {
+        const pt1_isdbt_segment_t *s = &isdbt_segments[i];
+        if (freq_hz < s->lo_hz - PT1_ISDBT_TOLERANCE_HZ) continue;
+        if (freq_hz > s->hi_hz + PT1_ISDBT_TOLERANCE_HZ) continue;
+
+        /* Round to the nearest 6 MHz step inside the segment. */
+        int64_t delta = (int64_t)freq_hz - (int64_t)s->lo_hz;
+        int     step  = (int)((delta + (int64_t)PT1_ISDBT_STEP_HZ / 2) /
+                              (int64_t)PT1_ISDBT_STEP_HZ);
+        uint32_t centre = s->lo_hz + (uint32_t)step * PT1_ISDBT_STEP_HZ;
+
+        uint32_t diff = (centre > freq_hz) ? centre - freq_hz : freq_hz - centre;
+        if (diff > PT1_ISDBT_TOLERANCE_HZ) continue;
+        if (centre < s->lo_hz || centre > s->hi_hz) continue;
+
+        out->frequencyno = s->base_no + step;
+        out->slot        = 0;
+        return 0;
+    }
+    return -1;
+}
+
+static int pt1_resolve_isdbs(uint32_t freq_khz, int slot, FREQUENCY *out)
+{
+    if (freq_khz <= PT1_ISDBS_LO_KHZ) return -1;
+    uint32_t if_khz = freq_khz - PT1_ISDBS_LO_KHZ;
+
+    /* BS plane */
+    if (if_khz + PT1_ISDBS_TOLERANCE_KHZ >= PT1_ISDBS_BS_LO_IF_KHZ &&
+        if_khz <= PT1_ISDBS_BS_HI_IF_KHZ + PT1_ISDBS_TOLERANCE_KHZ) {
+        int32_t delta = (int32_t)if_khz - (int32_t)PT1_ISDBS_BS_LO_IF_KHZ;
+        int     step  = (delta + (int32_t)PT1_ISDBS_BS_STEP_KHZ / 2) /
+                        (int32_t)PT1_ISDBS_BS_STEP_KHZ;
+        uint32_t centre = PT1_ISDBS_BS_LO_IF_KHZ + (uint32_t)step * PT1_ISDBS_BS_STEP_KHZ;
+        uint32_t diff   = (centre > if_khz) ? centre - if_khz : if_khz - centre;
+        if (step >= 0 && step <= 11 && diff <= PT1_ISDBS_TOLERANCE_KHZ) {
+            out->frequencyno = step;
+            out->slot        = slot;
+            return 0;
+        }
+    }
+
+    /* CS plane */
+    if (if_khz + PT1_ISDBS_TOLERANCE_KHZ >= PT1_ISDBS_CS_LO_IF_KHZ &&
+        if_khz <= PT1_ISDBS_CS_HI_IF_KHZ + PT1_ISDBS_TOLERANCE_KHZ) {
+        int32_t delta = (int32_t)if_khz - (int32_t)PT1_ISDBS_CS_LO_IF_KHZ;
+        int     step  = (delta + (int32_t)PT1_ISDBS_CS_STEP_KHZ / 2) /
+                        (int32_t)PT1_ISDBS_CS_STEP_KHZ;
+        uint32_t centre = PT1_ISDBS_CS_LO_IF_KHZ + (uint32_t)step * PT1_ISDBS_CS_STEP_KHZ;
+        uint32_t diff   = (centre > if_khz) ? centre - if_khz : if_khz - centre;
+        if (step >= 0 && step <= (23 - PT1_ISDBS_CS_BASE_NO) && diff <= PT1_ISDBS_TOLERANCE_KHZ) {
+            out->frequencyno = PT1_ISDBS_CS_BASE_NO + step;
+            out->slot        = slot;
+            return 0;
+        }
+    }
+
+    return -1;
+}
+
+int pt1_resolve_freq(uint32_t freq, int stream_id,
+                     dvb_fe_type_t type, FREQUENCY *out)
+{
+    if (out == NULL) return -1;
+    switch (type) {
+        case DVB_TYPE_ISDB_T:
+            return pt1_resolve_isdbt(freq, out);
+        case DVB_TYPE_ISDB_S:
+            return pt1_resolve_isdbs(freq, stream_id, out);
+        default:
+            return -1;
+    }
+}
