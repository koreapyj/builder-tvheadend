--- /dev/null
+++ src/src/input/mpegts/pt1/pt1_dev.h
@@ -0,0 +1,83 @@
+#ifndef _PT1_DEV_H_
+#define _PT1_DEV_H_
+#include "../dvb.h"
+#include "pt1_ioctl.h"
+
+/*
+ * Capability bitmask. A chardev is "hardwired" when only one bit is set;
+ * "unified" chardevs (PX5 / PXMLT5 / PXMLT8 / ISDB6014) set both bits and
+ * pick the delivery system at tune time via PTX_SET_SYSTEM_MODE.
+ */
+#define PT1_CAP_T   (1u << 0)   /* chardev supports ISDB-T */
+#define PT1_CAP_S   (1u << 1)   /* chardev supports ISDB-S */
+
+struct pt1_dev_info
+{
+    const char *path;
+    uint32_t    system_cap;     /* PT1_CAP_T | PT1_CAP_S (or both) */
+};
+
+typedef struct pt1_dev_info pt1_dev_info_t;
+
+const pt1_dev_info_t* is_pt1_dev_path(char const *path);
+
+/*
+ * Resolve a mux into the kernel ioctl arg for SET_CHANNEL.
+ *
+ *   ISDB-T : freq is the UHF/VHF centre frequency in Hz.
+ *            stream_id is ignored. out->slot is set to 0.
+ *   ISDB-S : freq is the PHYSICAL satellite downlink frequency in kHz
+ *            (e.g. 11727480 for BS-1). The Japanese BS LO of 10.678 GHz
+ *            is subtracted internally; tvheadend's network-level LNB
+ *            selector is NOT consulted (Japanese BS/CS is single-band and
+ *            does not fit tvheadend's Universal-LNB defaults).
+ *            stream_id supplies out->slot (the ARIB TSID the kernel uses
+ *            to pick a stream on the transponder).
+ *
+ * Returns 0 on success and fills *out, or -1 if the frequency falls outside
+ * any supported segment (with ±100 kHz tolerance).
+ */
+int pt1_resolve_freq(uint32_t freq, int stream_id,
+                     dvb_fe_type_t type, FREQUENCY *out);
+
+/*
+ * Resolve a chardev path (e.g. "/dev/pt3video0") into a human-readable
+ * adapter label that mirrors linuxdvb's "<name> #<idx>" convention, e.g.
+ * "Earthsoft PT3 #0" or "PLEX PX-MLT8PE #2".
+ *
+ * Tier 1: walk sysfs from the chardev's (major,minor) to its USB parent
+ *         and concatenate the kernel's `manufacturer`+`product` strings.
+ * Tier 2: same walk to a PCI parent; look up vendor:device in a small
+ *         static table of known PT cards.
+ * Tier 3: extract a family token from the chardev basename and look up
+ *         in a static family-name table.
+ * Tier 4: use the chardev basename verbatim.
+ *
+ * Appends a sequential "#N" derived from a per-label counter that
+ * persists for the lifetime of the process. Writes the final label into
+ * `out` (NUL-terminated). Returns 0 on success; the only error is an
+ * undersized buffer, in which case `out` is left empty and -1 returned.
+ */
+int pt1_make_adapter_label(const char *devpath, char *out, size_t outlen);
+
+/*
+ * Convert the kernel's raw CN reading from GET_SIGNAL_STRENGTH into a
+ * signed millibel (dB * 1000) value.
+ *
+ *   PT1 / PT3 chardevs use the historic Earthsoft chip — `raw` is a 24-bit
+ *     register; the conversion is the 5505024-based polynomial used by
+ *     recpt1.
+ *   px4_drv chardevs (PX4 / PX5 / PXMLT5 / PXMLT8 / ISDB6014) — `raw` is
+ *     already a cxd2856er CN value the kernel produced by table-lookup
+ *     ("10..34 dB / 0.5 dB" for ISDB-T, "0..20 dB / 0.1 dB" for ISDB-S).
+ *     We reverse-lookup our own copy of those tables to recover the dB.
+ *
+ * `path` is the chardev (`/dev/pt3video0`, `/dev/pxmlt8video1`, …) and
+ * picks which conversion to apply.
+ *
+ * Returns dB * 1000 on success, or `INT_MIN` if the raw value is out of
+ * the supported range for the chip family.
+ */
+int pt1_cn_to_millibel(const char *path, dvb_fe_type_t type, uint32_t raw);
+
+#endif
