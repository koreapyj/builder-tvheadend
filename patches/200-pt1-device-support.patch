===================================================================
--- /dev/null
+++ src/src/input/mpegts/pt1/pt1_ioctl.h
@@ -0,0 +1,43 @@
+#ifndef		__PT1_IOCTL_H__
+#define		__PT1_IOCTL_H__
+
+#include <stdint.h>
+
+/***************************************************************************/
+/* チャンネル周波数情報構造体定義                                          */
+/***************************************************************************/
+typedef	struct	_frequency{
+	int		frequencyno ;			// 周波数テーブル番号
+	int		slot ;					// スロット番号／加算する周波数
+}FREQUENCY;
+
+/***************************************************************************/
+/* IOCTL定義                                                               */
+/***************************************************************************/
+#define		SET_CHANNEL	_IOW(0x8D, 0x01, FREQUENCY)
+#define		START_REC	_IO(0x8D, 0x02)
+#define		STOP_REC	_IO(0x8D, 0x03)
+#define		GET_SIGNAL_STRENGTH	_IOR(0x8D, 0x04, int *)
+#define		LNB_ENABLE	_IOW(0x8D, 0x05, int)
+#define		LNB_DISABLE	_IO(0x8D, 0x06)
+#define PTX_SET_SYSTEM_MODE	_IOW(0x8d, 0x0b, int)
+
+/* Hardware PID filter on IT930x-based px4_drv devices.
+ * Binary-compatible with px4_drv's struct ptx_pid_filter / PTX_SET_PID_FILTER.
+ *   pass = 1 : let only the PIDs in pid[0..num-1] through, drop the rest
+ *   pass = 0 : drop the PIDs in pid[0..num-1], let the rest through
+ *   num  = 0 : disable the filter (revert to device-default behaviour)
+ * Userspace must keep num <= PTX_PID_FILTER_MAX_PIDS; older drivers without
+ * this ioctl return ENOSYS/ENOTTY, which the caller treats as a soft fail
+ * (software filtering still works). */
+#define PTX_PID_FILTER_MAX_PIDS 64
+
+struct ptx_pid_filter {
+	uint8_t  pass;
+	uint8_t  num;
+	uint16_t pid[PTX_PID_FILTER_MAX_PIDS];
+};
+
+#define SET_PID_FILTER	_IOW(0x8D, 0x0c, struct ptx_pid_filter)
+
+#endif
