+#if ENABLE_ARIBB24
+/* Decode an ARIB STD-B24 (ISDB / Japanese DTV) text buffer to UTF-8
+ * using libaribb24. A fresh decoder instance is used per call so the
+ * routine is self-contained and thread-safe. */
+static size_t conv_arib(const uint8_t *src, size_t srclen,
+                        char *dst, size_t *dstlen)
+{
+  arib_instance_t *ai;
+  arib_decoder_t *dec;
+  size_t n;
+
+  ai = arib_instance_new(NULL);
+  if (ai == NULL)
+    return -1;
+  dec = arib_get_decoder(ai);
+  if (dec == NULL) {
+    arib_instance_destroy(ai);
+    return -1;
+  }
+  arib_initialize_decoder(dec);
+  n = arib_decode_buffer(dec, (const unsigned char *)src, srclen,
+                         dst, *dstlen);
+  arib_finalize_decoder(dec);
+  arib_instance_destroy(ai);
+  if (n > *dstlen)
+    return -1;
+  *dstlen -= n;
+  return 0;
+}
+#endif
